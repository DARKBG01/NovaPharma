  <property name="styleSheet">
   <string notr="true">/* ============================================================
   NOVA PHARMA — DÉTAIL BLF
   ============================================================ */

QDialog { background-color: #f0f4f8; }

QWidget {
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;, &quot;Roboto&quot;, sans-serif;
    font-size: 13px;
    color: #0f172a;
    outline: none;
}

/* ══════════ HEADER ══════════ */
QFrame#header_frame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #023E8A, stop:0.4 #0077B6, stop:1 #00B4D8);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border: none;
}
QLabel#header_icon {
    background-color: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 14px;
    padding: 10px;
}
QLabel#header_numero {
    color: #ffffff;
    font-size: 20px;
    font-weight: 800;
    background: transparent;
    letter-spacing: 0.3px;
}
QLabel#header_sub {
    color: #CAF0F8;
    font-size: 12px;
    background: transparent;
}
QLabel#statut_badge {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    border-radius: 10px;
    padding: 8px 16px;
}

/* ══════════ CARTE ══════════ */
QFrame#card {
    background-color: #ffffff;
    border: 1px solid #e6ebf2;
    border-top: none;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}

/* ══════════ MÉTADONNÉES ══════════ */
QLabel#meta_key {
    color: #94a3b8;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    background: transparent;
}
QLabel#meta_value {
    color: #0f172a;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}

/* ══════════ LIGNES ══════════ */
QLabel#section_title {
    color: #334155;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    background: transparent;
}
QTableWidget#table_lignes {
    background-color: #ffffff;
    alternate-background-color: #fbfcfe;
    border: none;
    border-top: 1px solid #eef2f7;
    gridline-color: transparent;
    outline: none;
    color: #334155;
}
QTableWidget#table_lignes::item {
    padding: 10px 8px;
    border-bottom: 1px solid #f1f5f9;
}
QTableWidget#table_lignes::item:selected {
    background-color: #eff6ff;
    color: #0077B6;
}
QHeaderView::section {
    background-color: #f8fafc;
    color: #94a3b8;
    padding: 12px 8px;
    border: none;
    border-bottom: 2px solid #e6ebf2;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
}

/* ══════════ TOTAUX ══════════ */
QFrame#total_box {
    background-color: #eff6ff;
    border-top: 1px solid #dbeafe;
}
QLabel#total_caption {
    color: #1e40af;
    font-size: 12px;
    font-weight: 800;
    background: transparent;
}
QLabel#total_value {
    color: #023E8A;
    font-size: 20px;
    font-weight: 800;
    background: transparent;
}
QLabel#total_info {
    color: #1e40af;
    font-size: 12px;
    font-weight: 700;
    background: transparent;
}

/* ══════════ NOTES ══════════ */
QFrame#notes_wrap {
    background-color: #fefce8;
    border-top: 1px solid #fef08a;
}
QLabel#notes_text {
    color: #854d0e;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
}

/* ══════════ MOTIF ANNULATION ══════════ */
QFrame#motif_wrap {
    background-color: #fef2f2;
    border-top: 1px solid #fecaca;
}
QLabel#motif_text {
    color: #991b1b;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
}

/* ══════════ FOOTER ══════════ */
QFrame#footer_frame {
    background-color: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 18px;
}

QPushButton#btn_cancel_blf {
    background-color: #ffffff;
    color: #dc2626;
    border: 1.5px solid #fecaca;
    border-radius: 10px;
    padding: 10px 22px;
    font-size: 13px;
    font-weight: 700;
    min-height: 42px;
}
QPushButton#btn_cancel_blf:hover { background-color: #fef2f2; }

QPushButton#btn_validate_blf {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #16A34A, stop:1 #22c55e);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 10px 24px;
    font-size: 13px;
    font-weight: 800;
    min-width: 180px;
    min-height: 42px;
}
QPushButton#btn_validate_blf:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #15803d, stop:1 #16A34A);
}

QPushButton#btn_close {
    background-color: #ffffff;
    color: #475569;
    border: 1.5px solid #dbe3ec;
    border-radius: 10px;
    padding: 10px 24px;
    font-size: 13px;
    font-weight: 600;
    min-width: 110px;
    min-height: 42px;
}
QPushButton#btn_close:hover { background-color: #f8fafc; }

/* Scrollbar */
QScrollBar:vertical {
    border: none; background: transparent;
    width: 10px; margin: 2px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1; min-height: 32px; border-radius: 5px;
}
QScrollBar::handle:vertical:hover { background: #94a3b8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
</string>
