  <property name="styleSheet">
   <string notr="true">/* ═══════════════════════════════════════════════════════════════
   PAGE FACTURATION — NOVA PHARMA POS v6 (10/10 Responsive)
   Philosophie : Vitesse caissier · Responsive strict · Zéro friction
   ═══════════════════════════════════════════════════════════════ */

/* ───────── BASE ───────── */
#PageFacturation { background-color: #f1f5f9; }
#PageFacturation QLabel { background: transparent; color: #0f172a; }

/* ───────── HEADER ───────── */
#frame_page_header {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 #1e40af, stop:0.5 #2563eb, stop:1 #4f46e5);
    border: none; border-radius: 16px;
}
#frame_page_header QLabel { background: transparent; color: #ffffff; }
#ico_page_header { image: url(:/Icon/Icons/receipt_white.svg); background: rgba(255,255,255,0.18); border: 1px solid rgba(255,255,255,0.35); border-radius: 12px; padding: 8px; }
#label_23 { color: #ffffff; }
#label_23_date { color: rgba(255,255,255,0.75); font-size: 11px; font-weight: 500; }
#badge_mode_vente { background: rgba(255,255,255,0.22); color: #ffffff; border: 1px solid rgba(255,255,255,0.45); border-radius: 20px; padding: 6px 14px; font-size: 10px; font-weight: 800; letter-spacing: 1.2px; }

/* ───────── CARTES ───────── */
#frame_13, #frame_12, #frame_bottom_actions {
    background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px;
}

/* ───────── ICÔNES DE SECTION ───────── */
#ico_card_articles, #ico_card_panier, #ico_card_client, #ico_card_client_info, #ico_card_resume { border-radius: 8px; padding: 5px; }
#ico_card_articles { image: url(:/Icon/Icons/pill.svg); background: #eff6ff; border: 1px solid #dbeafe; }
#ico_card_panier { image: url(:/Icon/Icons/shopping-cart.svg); background: #eff6ff; border: 1px solid #dbeafe; }
#ico_card_client { image: url(:/Icon/Icons/user.svg); background: #eff6ff; border: 1px solid #dbeafe; }
#ico_card_client_info { image: url(:/Icon/Icons/user-check.svg); background: #f0fdf4; border: 1px solid #bbf7d0; }
#ico_card_resume { image: url(:/Icon/Icons/dollar.svg); background: #f0fdf4; border: 1px solid #bbf7d0; }

/* ───────── TITRES ───────── */
#label_4, #label_8, #label_24, #label_37, #label_panier_title { color: #0f172a; font-size: 14px; font-weight: 800; letter-spacing: -0.2px; }
#label_panier_title { font-size: 15px; }
#label_7, #label_21, #label_22, #label_31, #label_38, #label_39 { color: #94a3b8; font-size: 10px; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; }
#label_27 { color: #94a3b8; font-size: 11px; font-weight: 600; }

/* ───────── CHAMPS (RESPONSIVE) ───────── */
#edit_name_client, #edit_identification_client, #edit_numero_client, #spin_quantite_facture, #spin_nbr_stock {
    background-color: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 10px;
    padding: 10px 14px; color: #0f172a; font-size: 13px; font-weight: 500; min-height: 22px;
}
/* 🌟 Zone de Scan/Recherche : Mise en évidence maximale */
#edit_recherche_produit {
    background-color: #ffffff; border: 2px solid #bfdbfe; border-radius: 12px;
    padding: 12px 16px; color: #0f172a; font-size: 15px; font-weight: 600; min-height: 24px;
}
#edit_recherche_produit:hover, #edit_name_client:hover, #spin_quantite_facture:hover { border-color: #94a3b8; background-color: #ffffff; }
#edit_recherche_produit:focus, #edit_name_client:focus, #spin_quantite_facture:focus { border: 2px solid #2563eb; background-color: #ffffff; }
#edit_identification_client, #edit_numero_client, #spin_nbr_stock { background-color: #f1f5f9; color: #64748b; border-color: #e2e8f0; }

/* ───────── BOUTONS PRINCIPAUX ───────── */
#btn_add_produit_for_facture, #btn_recheche_person_facture {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #3b82f6, stop:1 #2563eb);
    color: #ffffff; border: none; border-radius: 10px; padding: 10px 20px; font-size: 13px; font-weight: 800; min-height: 22px;
}
#btn_add_produit_for_facture:hover, #btn_recheche_person_facture:hover { background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #2563eb, stop:1 #1d4ed8); }
#btn_register_new_client { background: #f0fdf4; color: #15803d; border: 1.5px solid #bbf7d0; border-radius: 10px; padding: 10px 16px; font-size: 12px; font-weight: 700; min-height: 22px; }
#btn_register_new_client:hover { background: #dcfce7; border-color: #86efac; }

/* 🌟 Bouton Imprimer/Valider : Géant et accessible */
#btn_print_facture {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #16a34a, stop:1 #15803d);
    color: #ffffff; border: none; border-radius: 14px; padding: 16px 20px; font-size: 16px; font-weight: 800; letter-spacing: 0.3px; min-height: 26px;
}
#btn_print_facture:hover { background: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #15803d, stop:1 #166534); }

/* ───────── BOUTONS SECONDAIRES (TOOLBAR) ───────── */
#btn_remove_line_facture, #btn_clear_table_facture, #btn_mes_ventes_jour, #btn_rapport_z {
    background: #f8fafc; color: #475569; border: 1px solid #e2e8f0; border-radius: 10px; padding: 10px 16px; font-size: 12px; font-weight: 700;
}
#btn_remove_line_facture { color: #dc2626; border-color: #fecaca; }
#btn_remove_line_facture:hover { background: #fef2f2; border-color: #fca5a5; }
#btn_mes_ventes_jour { color: #1d4ed8; border-color: #bfdbfe; }
#btn_mes_ventes_jour:hover { background: #eff6ff; border-color: #93c5fd; }
#btn_rapport_z { color: #92400e; border-color: #fde68a; }
#btn_rapport_z:hover { background: #fefce8; border-color: #fcd34d; }
#btn_clear_table_facture:hover { background: #f1f5f9; border-color: #cbd5e1; color: #0f172a; }

/* ───────── TABLE PANIER ───────── */
#tableWidget { background-color: transparent; border: none; outline: none; font-size: 13px; font-weight: 500; }
#tableWidget::item { padding: 14px 12px; border-bottom: 1px solid #f1f5f9; color: #334155; }
#tableWidget::item:hover { background-color: #f8fafc; }
#tableWidget::item:selected { background-color: #eff6ff; color: #1d4ed8; border-left: 4px solid #2563eb; }
#tableWidget QHeaderView::section { background-color: #f8fafc; color: #94a3b8; padding: 12px; border: none; border-bottom: 2px solid #e6ebf2; font-size: 10px; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; }

/* ───────── TOTAUX ───────── */
#lbl_total_nbr_produit { color: #0f172a; font-size: 18px; font-weight: 800; }
#lbl_totale_calc { color: #16a34a; font-size: 36px; font-weight: 900; letter-spacing: -1px; }
#label_25, #label_28 { color: #64748b; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }

/* ───────── SÉPARATEURS ───────── */
#PageFacturation QFrame[frameShape=&quot;4&quot;], #PageFacturation Line { background-color: #f1f5f9; border: none; max-height: 1px; }

/* ───────── SCROLLBARS ───────── */
QScrollBar:vertical { border: none; background: transparent; width: 6px; margin: 2px; }
QScrollBar::handle:vertical { background: #e2e8f0; min-height: 36px; border-radius: 3px; }
QScrollBar::handle:vertical:hover { background: #94a3b8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
</string>
