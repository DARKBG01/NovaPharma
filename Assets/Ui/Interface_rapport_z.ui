  <property name="windowTitle">
   <string>Clôture de caisse — Rapport Z</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QDialog { background: #f0f4f8; }
QFrame#header_z {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #023E8A, stop:0.5 #0077B6, stop:1 #00B4D8);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
}
QFrame#card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}
QLabel { color: #334155; font-size: 13px; background: transparent; }
QLabel#header_title { color: white; font-size: 18px; font-weight: 800; }
QLabel#header_sub   { color: #CAF0F8; font-size: 11px; }
QLabel#section_title {
    color: #023E8A; font-size: 13px; font-weight: 800;
    background: transparent;
}
QLabel#value_big {
    color: #0f172a; font-size: 22px; font-weight: 800;
    background: transparent;
}
QLabel#value_money {
    color: #023E8A; font-size: 14px; font-weight: 800;
    background: transparent;
}
QLabel#ecart_ok    { color: #16A34A; font-size: 16px; font-weight: 800; }
QLabel#ecart_warn  { color: #F4A261; font-size: 16px; font-weight: 800; }
QLabel#ecart_danger{ color: #DC2626; font-size: 16px; font-weight: 800; }
QLineEdit, QComboBox, QDateEdit, QDoubleSpinBox {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    padding: 8px 12px;
    color: #0f172a;
    font-size: 13px;
    min-height: 22px;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QDoubleSpinBox:focus {
    background: #ffffff;
    border-color: #00B4D8;
}
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0077B6, stop:1 #00B4D8);
    color: white;
    border: none;
    border-radius: 10px;
    padding: 10px 22px;
    font-size: 13px;
    font-weight: 700;
    min-width: 120px;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #023E8A, stop:1 #0077B6);
}
QPushButton#btn_secondary {
    background: transparent;
    color: #64748b;
    border: 1.5px solid #e2e8f0;
}
QPushButton#btn_secondary:hover {
    background: #fef2f2;
    color: #dc2626;
    border-color: #fecaca;
}
   </string>
