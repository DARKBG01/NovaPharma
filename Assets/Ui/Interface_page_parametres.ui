  <property name="styleSheet">
   <string notr="true">/* ═══════════════ BASE ═══════════════ */ QWidget#PageParametres { background: #f0f4f8; } QWidget#PageParametres QLabel { background: transparent; } /* ═══════════════ CARTE PRINCIPALE ═══════════════ */ QFrame#card { background: #ffffff; border: 1px solid #e6ebf2; border-radius: 20px; } /* ═══════════════ HEADER ═══════════════ */ QFrame#header_frame { background: #ffffff; border-top-left-radius: 20px; border-top-right-radius: 20px; border: none; } QLabel#header_icon { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0077B6, stop:1 #00B4D8); border-radius: 14px; padding: 12px; } QLabel#page_title { color: #0f172a; font-size: 22px; font-weight: 800; letter-spacing: -0.3px; } QLabel#page_subtitle { color: #64748b; font-size: 12px; } QLabel#version_badge { background: #eff6ff; color: #023E8A; border: 1px solid #bfdbfe; border-radius: 10px; padding: 6px 12px; font-size: 10px; font-weight: 800; letter-spacing: 1px; } /* ═══════════════ TABS (style pill) ═══════════════ */ QTabWidget::pane { background: transparent; border: none; top: 0; } QTabBar { background: transparent; qproperty-drawBase: 0; qproperty-expanding: 1; } QTabBar::tab { background: transparent; color: #64748b; padding: 9px 18px; margin-right: 6px; border-radius: 10px; font-size: 12px; font-weight: 700; border: 1px solid transparent; } QTabBar::tab:selected { background: #023E8A; color: #ffffff; border-color: #023E8A; } QTabBar::tab:hover:!selected { background: #eff6ff; color: #0077B6; border-color: #dbeafe; } /* ═══════════════ SECTIONS (cartes blanches) ═══════════════ */ QFrame#section_card { background: #ffffff; border: 1px solid #e6ebf2; border-radius: 14px; } QFrame#section_sep { background: #eef2f7; border: none; max-height: 1px; min-height: 1px; } QLabel#section_icon { background: #e0f2fe; color: #023E8A; border-radius: 8px; padding: 6px; font-size: 12px; font-weight: 800; } QLabel#section_title { color: #0f172a; font-size: 14px; font-weight: 800; letter-spacing: -0.1px; } QLabel#section_hint { color: #94a3b8; font-size: 11px; font-style: italic; } /* ═══════════════ CHAMPS ═══════════════ */ QLabel[fieldLabel=&quot;true&quot;] { color: #475569; font-size: 11px; font-weight: 700; letter-spacing: 0.2px; } QLabel[fieldHint=&quot;true&quot;] { color: #94a3b8; font-size: 10px; } QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit { background: #ffffff; border: 1.5px solid #dbe3ec; border-radius: 10px; padding: 10px 14px; color: #0f172a; font-size: 13px; font-weight: 500; min-height: 22px; } QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QPlainTextEdit:hover { border-color: #b9c6d8; } QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus { background: #ffffff; border: 1.5px solid #0077B6; } QComboBox::drop-down { border: none; width: 26px; } QComboBox QAbstractItemView { background: #ffffff; border: 1px solid #e6ebf2; border-radius: 10px; padding: 6px; selection-background-color: #eff6ff; selection-color: #0077B6; outline: none; } /* ═══════════════ CHECKBOX ═══════════════ */ QCheckBox { color: #334155; font-size: 12px; font-weight: 600; spacing: 10px; padding: 6px 0; background: transparent; } QCheckBox::indicator { width: 18px; height: 18px; border: 1.5px solid #cbd5e1; background: #ffffff; border-radius: 5px; } QCheckBox::indicator:hover { border-color: #0077B6; } QCheckBox::indicator:checked { background: #0077B6; border-color: #0077B6; image: url(:/Icon/Icons/check_white.svg); } /* ═══════════════ BOUTONS D'ACTION ═══════════════ */ QPushButton#btn_save { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0077B6, stop:1 #00B4D8); color: #ffffff; border: none; border-radius: 11px; padding: 12px 28px; font-size: 13px; font-weight: 800; min-height: 44px; letter-spacing: 0.3px; } QPushButton#btn_save:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #023E8A, stop:1 #0077B6); } QPushButton#btn_save:pressed { background: #023E8A; } QPushButton#btn_reload { background: #ffffff; color: #475569; border: 1.5px solid #dbe3ec; border-radius: 11px; padding: 12px 22px; font-size: 13px; font-weight: 700; min-height: 44px; } QPushButton#btn_reload:hover { background: #f8fafc; border-color: #c3cedd; color: #0f172a; } QPushButton#btn_upload_logo { background: #eff6ff; color: #023E8A; border: 1.5px solid #bfdbfe; border-radius: 10px; padding: 10px 20px; font-size: 12px; font-weight: 700; min-height: 40px; } QPushButton#btn_upload_logo:hover { background: #dbeafe; border-color: #93c5fd; } QPushButton#btn_remove_logo { background: #ffffff; color: #dc2626; border: 1.5px solid #fecaca; border-radius: 10px; padding: 10px 20px; font-size: 12px; font-weight: 700; min-height: 40px; } QPushButton#btn_remove_logo:hover { background: #fef2f2; } QPushButton#btn_browse_save { background: #eff6ff; color: #023E8A; border: 1.5px solid #bfdbfe; border-radius: 10px; padding: 10px 20px; font-size: 12px; font-weight: 700; min-height: 40px; } QPushButton#btn_browse_save:hover { background: #dbeafe; border-color: #93c5fd; } /* ═══════════════ DANGER ZONE ═══════════════ */ QFrame#danger_card_info { background: #fffbeb; border: 1px solid #fde68a; border-radius: 12px; } QFrame#danger_card_warn { background: #ffffff; border: 1px solid #e6ebf2; border-radius: 12px; } QFrame#danger_card_danger { background: #fef2f2; border: 1px solid #fecaca; border-radius: 12px; } QLabel#danger_icon_info { background: #fde68a; color: #92400e; border-radius: 8px; padding: 6px; font-size: 12px; font-weight: 800; } QLabel#danger_icon_warn { background: #dbeafe; color: #023E8A; border-radius: 8px; padding: 6px; font-size: 12px; font-weight: 800; } QLabel#danger_icon_danger { background: #fecaca; color: #b91c1c; border-radius: 8px; padding: 6px; font-size: 12px; font-weight: 800; } QLabel#danger_title { color: #0f172a; font-size: 13px; font-weight: 800; } QLabel#danger_title_red { color: #b91c1c; font-size: 13px; font-weight: 800; } QLabel#danger_desc { color: #64748b; font-size: 11px; } QLabel#danger_desc_red { color: #991b1b; font-size: 11px; } QPushButton#btn_export_db { background: #eff6ff; color: #023E8A; border: 1.5px solid #bfdbfe; border-radius: 10px; padding: 10px 22px; font-size: 12px; font-weight: 700; min-height: 42px; } QPushButton#btn_export_db:hover { background: #dbeafe; } QPushButton#btn_restore_db { background: #fef3c7; color: #92400e; border: 1.5px solid #fcd34d; border-radius: 10px; padding: 10px 22px; font-size: 12px; font-weight: 700; min-height: 42px; } QPushButton#btn_restore_db:hover { background: #fde68a; } QPushButton#btn_reset_all { background: #dc2626; color: #ffffff; border: none; border-radius: 10px; padding: 10px 22px; font-size: 12px; font-weight: 800; min-height: 42px; } QPushButton#btn_reset_all:hover { background: #b91c1c; } QPushButton#btn_reset_all:pressed { background: #991b1b; } /* ═══════════════ FOOTER ═══════════════ */ QFrame#footer_frame { background: #f8fafc; border-top: 1px solid #eef2f7; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px; border: none; } QLabel#lbl_status { color: #94a3b8; font-size: 11px; font-weight: 600; } QLabel#lbl_status[status=&quot;ok&quot;] { color: #16A34A; font-weight: 700; } QLabel#lbl_status[status=&quot;warn&quot;] { color: #b45309; font-weight: 700; } /* ═══════════════ SCROLLBARS ═══════════════ */ QScrollArea { background: transparent; border: none; } QScrollArea &gt; QWidget &gt; QWidget { background: transparent; } QScrollBar:vertical { border: none; background: transparent; width: 10px; margin: 2px; } QScrollBar::handle:vertical { background: #cbd5e1; min-height: 32px; border-radius: 5px; } QScrollBar::handle:vertical:hover { background: #94a3b8; } QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; } QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; } /* ═══════════════ LIGNES DE SÉPARATION ═══════════════ */ QFrame[isSep=&quot;true&quot;] { background: #eef2f7; border: none; max-height: 1px; min-height: 1px; }

