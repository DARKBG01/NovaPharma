  <property name="styleSheet">
   <string notr="true">/* ============================================================
   NOVA PHARMA — DIALOG CLIENT (ajout / modification)
   ============================================================ */

QDialog { background-color: #f0f4f8; }

QWidget {
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;, &quot;Roboto&quot;, sans-serif;
    font-size: 13px;
    color: #0f172a;
    outline: none;
}

/* ══════════════ SIDEBAR ══════════════ */
QFrame#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0.7, y2:1,
        stop:0 #023E8A, stop:0.5 #0077B6, stop:1 #00B4D8);
    border: none;
    border-top-left-radius: 16px;
    border-bottom-left-radius: 16px;
}

QFrame#brand_badge {
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.28);
    border-radius: 14px;
}
QLabel#brand_badge_text {
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    background: transparent;
}

QLabel#sidebar_title {
    color: #ffffff;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.5px;
    background: transparent;
}

QLabel#sidebar_lead {
    color: #CAF0F8;
    font-size: 12px;
    background: transparent;
}

QFrame#check_row {
    background: rgba(255,255,255,0.10);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 12px;
}
QFrame#check_row[done=&quot;true&quot;] {
    background: rgba(255,255,255,0.25);
    border: 1px solid rgba(255,255,255,0.40);
}
QLabel#check_text {
    color: #e0e7ff;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}
QFrame#check_row[done=&quot;true&quot;] QLabel#check_text { color: #ffffff; }

QLabel#progress_label {
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    background: transparent;
    min-width: 45px;
    qproperty-alignment: 'AlignRight | AlignVCenter';
}
QProgressBar#progress_bar {
    background-color: rgba(255,255,255,0.18);
    border: none;
    border-radius: 5px;
    height: 10px;
    max-height: 10px;
}
QProgressBar#progress_bar::chunk {
    background-color: #90E0EF;
    border-radius: 5px;
}

QLabel#sidebar_footer {
    color: rgba(255,255,255,0.65);
    font-size: 11px;
    background: transparent;
}

/* ══════════════ PANEL ══════════════ */
QFrame#panel {
    background-color: #ffffff;
    border: 1px solid #e6ebf2;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
}

QLabel#panel_title {
    color: #0f172a;
    font-size: 20px;
    font-weight: 800;
    background: transparent;
}
QLabel#panel_subtitle {
    color: #64748b;
    font-size: 12px;
    background: transparent;
}

QLabel#section_num {
    background-color: #e0f7fa;
    color: #0077B6;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 800;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
    qproperty-alignment: 'AlignCenter';
}
QLabel#section_title {
    color: #334155;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    background: transparent;
}

QLabel#field_label {
    color: #334155;
    font-size: 12px;
    font-weight: 700;
    background: transparent;
}
QLabel#field_required {
    color: #dc2626;
    font-size: 13px;
    font-weight: 800;
    background: transparent;
}
QLabel#field_opt {
    color: #0077B6;
    font-size: 10px;
    font-weight: 700;
    background-color: #e0f7fa;
    border-radius: 8px;
    padding: 2px 8px;
}

QLineEdit, QTextEdit,QComboBox {
    background-color: #f8fafc;
    border: 1.5px solid #dbe3ec;
    border-radius: 11px;
    padding: 10px 14px;
    color: #0f172a;
    font-size: 13px;
    font-weight: 500;
    selection-background-color: #bfdbfe;
}
QLineEdit:hover, QTextEdit:hover, QComboBox:hover { border-color: #b9c6d8; }
QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    background-color: #ffffff;
    border: 1.5px solid #0077B6;
}

QComboBox::drop-down { border: none; width: 26px; }
QComboBox::down-arrow {
    image: url(:/Icon/Icons/chevron-down.svg);
    width: 12px; height: 12px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 10px;
    padding: 6px;
    selection-background-color: #eff6ff;
    selection-color: #0077B6;
    outline: none;
}

QLineEdit:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e6ebf2;
}

/* Toggle anonymat */
QFrame#anon_box {
    background-color: #f0f9ff;
    border: 1.5px solid #bae6fd;
    border-radius: 12px;
}
QFrame#anon_box[on=&quot;true&quot;] {
    background-color: #fef3c7;
    border: 1.5px solid #fcd34d;
}
QCheckBox#anon_check {
    color: #0369a1;
    font-size: 13px;
    font-weight: 700;
    spacing: 10px;
    background: transparent;
}
QCheckBox#anon_check::indicator {
    width: 22px; height: 22px;
    border: 2px solid #bae6fd;
    border-radius: 6px;
    background-color: #ffffff;
}
QCheckBox#anon_check::indicator:checked {
    background-color: #d97706;
    border: 2px solid #d97706;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAiIGhlaWdodD0iOCIgdmlld0JveD0iMCAwIDEwIDgiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PHBhdGggZD0iTTEgNEwzLjUgNi41TDkgMSIgc3Ryb2tlPSJ3aGl0ZSIgc3Ryb2tlLXdpZHRoPSIyIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz48L3N2Zz4=);
}
QLabel#anon_hint {
    color: #0284c7;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}

/* Bandeau info anonyme */
QFrame#anon_banner {
    background-color: #fef3c7;
    border: 1px solid #fcd34d;
    border-left: 4px solid #d97706;
    border-radius: 10px;
}
QLabel#anon_banner_text {
    color: #92400e;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
}

/* Erreur */
QFrame#error_box {
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    border-left: 4px solid #dc2626;
    border-radius: 10px;
}
QLabel#label_error {
    color: #991b1b;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

/* Footer */
QFrame#panel_footer {
    background-color: #f8fafc;
    border-top: 1px solid #eef2f7;
    border-bottom-right-radius: 16px;
}

QPushButton#btn_cancel {
    background-color: #ffffff;
    color: #64748b;
    border: 1.5px solid #dbe3ec;
    border-radius: 11px;
    padding: 12px 26px;
    font-size: 13px;
    font-weight: 600;
    min-width: 120px;
    min-height: 44px;
}
QPushButton#btn_cancel:hover {
    background-color: #fef2f2;
    color: #dc2626;
    border-color: #fecaca;
}

QPushButton#btn_save {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0077B6, stop:1 #00B4D8);
    color: #ffffff;
    border: none;
    border-radius: 11px;
    padding: 12px 30px;
    font-size: 13px;
    font-weight: 800;
    min-width: 190px;
    min-height: 44px;
}
QPushButton#btn_save:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #023E8A, stop:1 #0077B6);
}
QPushButton#btn_save:pressed { background: #023E8A; }

/* Scroll */
QScrollArea { background-color: transparent; border: none; }
QScrollArea &gt; QWidget &gt; QWidget { background-color: #ffffff; }
QScrollBar:vertical { border: none; background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #cbd5e1; min-height: 32px; border-radius: 5px; }
QScrollBar::handle:vertical:hover { background: #94a3b8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
</string>
