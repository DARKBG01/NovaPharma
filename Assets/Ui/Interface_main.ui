        <widget class="QWidget" name="page_9">
         <property name="styleSheet">
          <string notr="true">/* ===========================
                                            PAGE 9 - BLF / FOURNISSEURS
                                            =========================== */

                                            QWidget#page_9 {
                                            background-color: transparent;
                                            }

                                            QLabel{
                                            background-color : transparent;
                                            }

                                            /* Cartes principales */
                                            #frame_blf_header,
                                            #frame_blf_table {
                                            background-color: #ffffff;
                                            border: 1px solid #e6ebf2;
                                            border-radius: 18px;
                                            }

                                            /* Bande des stats : fond transparent, cartes internes
                                            arrondies */
                                            #frame_blf_stats {
                                            background-color: transparent;
                                            border: none;
                                            }

                                            #frame_blf_stat1,
                                            #frame_blf_stat2,
                                            #frame_blf_stat3 {
                                            background-color: #ffffff;
                                            border: 1px solid #e6ebf2;
                                            border-radius: 18px;
                                            }

                                            #frame_blf_stat1:hover,
                                            #frame_blf_stat2:hover,
                                            #frame_blf_stat3:hover {
                                            border: 1px solid #bfdbfe;
                                            }

                                            /* Titres du header */
                                            #lbl_blf_title {
                                            font-size: 19px;
                                            font-weight: 800;
                                            color: #0f172a;
                                            }

                                            #lbl_blf_subtitle {
                                            font-size: 9px;
                                            font-weight: 800;
                                            text-transform: uppercase;
                                            letter-spacing: 0.22em;
                                            color: #2563eb;
                                            }

                                            /* Champ de recherche */
                                            QLineEdit#edit_blf_search {
                                            background-color: #f1f5f9;
                                            border-radius: 999px;
                                            border: 1px solid transparent;
                                            padding: 8px 16px;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: #334155;
                                            }

                                            QLineEdit#edit_blf_search:hover {
                                            background-color: #e8eef6;
                                            }

                                            QLineEdit#edit_blf_search:focus {
                                            border: 1px solid #2563eb;
                                            background-color: #ffffff;
                                            }

                                            /* Bouton : nouveau partenaire */
                                            QPushButton#btn_blf_new_supplier {
                                            background-color: #ffffff;
                                            border: 1px solid #dbe3ec;
                                            border-radius: 999px;
                                            padding: 8px 18px;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: #334155;
                                            }

                                            QPushButton#btn_blf_new_supplier:hover {
                                            background-color: #f8fafc;
                                            border-color: #c3cedd;
                                            color: #0f172a;
                                            }

                                            /* Bouton : passer une commande */
                                            QPushButton#btn_blf_new_order {
                                            background-color: qlineargradient(spread:pad, x1:0,
                                            y1:0, x2:0, y2:1, stop:0 #3b82f6, stop:1 #2563eb);
                                            border-radius: 999px;
                                            padding: 8px 18px;
                                            font-size: 11px;
                                            font-weight: 800;
                                            color: #ffffff;
                                            border: 1px solid #1d4ed8;
                                            }

                                            QPushButton#btn_blf_new_order:hover {
                                            background-color: qlineargradient(spread:pad, x1:0,
                                            y1:0, x2:0, y2:1, stop:0 #2f74e8, stop:1 #1d4ed8);
                                            }

                                            /* Icônes des stats */
                                            #lbl_blf_stat1_icon,
                                            #lbl_blf_stat2_icon,
                                            #lbl_blf_stat3_icon {
                                            font-size: 12px;
                                            font-weight: 800;
                                            }

                                            /* Texte des stats */
                                            #lbl_blf_stat1_label,
                                            #lbl_blf_stat2_label,
                                            #lbl_blf_stat3_label {
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: #64748b;
                                            }

                                            /* Valeurs des stats */
                                            #lbl_blf_stat1_value,
                                            #lbl_blf_stat2_value,
                                            #lbl_blf_stat3_value {
                                            font-size: 22px;
                                            font-weight: 800;
                                            color: #0f172a;
                                            }

                                            /* Titre de la table principale */
                                            #lbl_blf_table_title {
                                            font-size: 12px;
                                            font-weight: 800;
                                            text-transform: uppercase;
                                            letter-spacing: 0.14em;
                                            color: #0f172a;
                                            }

                                            /* TABLE BLF */
                                            QTableWidget#tbw_blf_lignes {
                                            background-color: transparent;
                                            border: none;
                                            gridline-color: #f1f5f9;
                                            outline: none;
                                            }

                                            QTableWidget#tbw_blf_lignes::item {
                                            padding: 10px;
                                            border-bottom: 1px solid #f1f5f9;
                                            color: #334155;
                                            font-size: 12px;
                                            font-weight: 500;
                                            }

                                            QTableWidget#tbw_blf_lignes::item:hover {
                                            background-color: #f8fafc;
                                            }

                                            QTableWidget#tbw_blf_lignes::item:selected {
                                            background-color: #eff6ff;
                                            color: #1d4ed8;
                                            }

                                            /* En-tête du tableau */
                                            QHeaderView::section {
                                            background-color: rgba(248, 250, 252, 0.9);
                                            color: #94a3b8;
                                            padding: 12px;
                                            border: 0px solid transparent;
                                            border-bottom: 1px solid #e6ebf2;
                                            font-weight: 800;
                                            text-transform: uppercase;
                                            font-size: 10px;
                                            letter-spacing: 0.16em;
                                            }

                                            QTableWidget#tbw_blf_lignes::corner {
                                            background-color: #f8fafc;
                                            border: none;
                                            }

                                            /* Scrollbars */
                                            QScrollBar:vertical {
                                            border: none;
                                            background: transparent;
                                            width: 10px;
                                            margin: 2px;
                                            }

                                            QScrollBar::handle:vertical {
                                            background: #cbd5e1;
                                            min-height: 32px;
                                            border-radius: 5px;
                                            }

                                            QScrollBar::handle:vertical:hover {
                                            background: #94a3b8;
                                            }

                                            QScrollBar::add-line:vertical,
                                            QScrollBar::sub-line:vertical {
                                            height: 0px;
                                            }

                                            QScrollBar:horizontal {
                                            border: none;
                                            background: transparent;
                                            height: 10px;
                                            }

                                            QScrollBar::handle:horizontal {
                                            background: #cbd5e1;
                                            min-width: 32px;
                                            border-radius: 5px;
                                            }</string>
         </property>
