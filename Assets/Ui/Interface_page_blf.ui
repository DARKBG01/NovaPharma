  <property name="styleSheet">
   <string notr="true">/* ============================================================
   NOVA PHARMA — PAGE BLF (design system v2)
   ============================================================ */

QWidget#PageBLF {
    background-color: transparent;
}

/* ══════════════ CARTE PRINCIPALE ══════════════ */
QFrame#main_card {
    background-color: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 18px;
}

/* ══════════════ HEADER ══════════════ */
QFrame#header_frame {
    background-color: #ffffff;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border: none;
}
QLabel#header_title {
    color: #0f172a;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.3px;
    background: transparent;
}
QLabel#header_subtitle {
    color: #64748b;
    font-size: 12px;
    background: transparent;
}
QLabel#header_badge {
    color: #0077B6;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
    background-color: #e0f7fa;
    border: 1px solid #bae6fd;
    border-radius: 10px;
    padding: 5px 12px;
}

/* ══════════════ BARRE DE SÉPARATION ══════════════ */
QFrame#header_sep {
    background-color: #eef2f7;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

/* ══════════════ TOOLBAR ══════════════ */
QFrame#toolbar_frame {
    background-color: #ffffff;
    border: none;
}
QLineEdit#search_input {
    background-color: #f8fafc;
    border: 1.5px solid #dbe3ec;
    border-radius: 11px;
    padding: 10px 14px;
    color: #0f172a;
    font-size: 13px;
    font-weight: 500;
    selection-background-color: #bfdbfe;
}
QLineEdit#search_input:hover { border-color: #b9c6d8; }
QLineEdit#search_input:focus {
    background-color: #ffffff;
    border: 1.5px solid #0077B6;
}

QComboBox#filter_combo {
    background-color: #f8fafc;
    border: 1.5px solid #dbe3ec;
    border-radius: 11px;
    padding: 10px 14px;
    color: #0f172a;
    font-size: 13px;
    font-weight: 600;
}
QComboBox#filter_combo:hover { border-color: #b9c6d8; }
QComboBox#filter_combo:focus { border-color: #0077B6; }
QComboBox#filter_combo::drop-down { border: none; width: 26px; }
QComboBox#filter_combo::down-arrow {
    image: url(:/Icon/Icons/chevron-down.svg);
    width: 12px; height: 12px;
}
QComboBox#filter_combo QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 10px;
    padding: 6px;
    selection-background-color: #eff6ff;
    selection-color: #0077B6;
    outline: none;
}

QPushButton#btn_refresh {
    background-color: #ffffff;
    color: #475569;
    border: 1.5px solid #dbe3ec;
    border-radius: 11px;
    padding: 11px;
    min-width: 42px;
    max-width: 42px;
    min-height: 42px;
}
QPushButton#btn_refresh:hover {
    background-color: #f8fafc;
    border-color: #c3cedd;
    color: #0f172a;
}
QPushButton#btn_refresh:pressed { background-color: #eef2f7; }

/* ─── Bouton &quot;Nouveau fournisseur&quot; (blanc / outline bleu) ─── */
QPushButton#btn_new_supplier {
    background-color: #ffffff;
    color: #023E8A;
    border: 1.5px solid #dbe3ec;
    border-radius: 11px;
    padding: 11px 20px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2px;
    min-height: 42px;
}
QPushButton#btn_new_supplier:hover {
    background-color: #eff6ff;
    border-color: #bfdbfe;
    color: #0077B6;
}
QPushButton#btn_new_supplier:pressed {
    background-color: #dbeafe;
    border-color: #93c5fd;
}

/* ─── Bouton &quot;Nouveau BLF&quot; (primaire dégradé) ─── */
QPushButton#btn_new {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0077B6, stop:1 #00B4D8);
    color: #ffffff;
    border: none;
    border-radius: 11px;
    padding: 11px 22px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.2px;
    min-height: 42px;
}
QPushButton#btn_new:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #023E8A, stop:1 #0077B6);
}
QPushButton#btn_new:pressed { background: #023E8A; }

/* ══════════════ TABLE ══════════════ */
QTableWidget#blf_table {
    background-color: #ffffff;
    alternate-background-color: #fbfcfe;
    border: none;
    border-top: 1px solid #eef2f7;
    border-bottom: 1px solid #eef2f7;
    gridline-color: transparent;
    outline: none;
    color: #334155;
    font-size: 13px;
}
QTableWidget#blf_table::item {
    padding: 12px 8px;
    border-bottom: 1px solid #f1f5f9;
    color: #334155;
}
QTableWidget#blf_table::item:hover {
    background-color: #f8fafc;
}
QTableWidget#blf_table::item:selected {
    background-color: #eff6ff;
    color: #0077B6;
}

QHeaderView {
    background-color: transparent;
    border: none;
}
QHeaderView::section {
    background-color: #f8fafc;
    color: #94a3b8;
    padding: 14px 10px;
    border: none;
    border-bottom: 2px solid #e6ebf2;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
}
QTableCornerButton::section {
    background-color: #f8fafc;
    border: none;
}

/* ══════════════ PAGINATION ══════════════ */
QFrame#pagination_frame {
    background-color: #f8fafc;
    border: none;
    border-top: 1px solid #eef2f7;
    border-bottom: 1px solid #eef2f7;
}
QPushButton#btn_prev,
QPushButton#btn_next {
    background-color: #ffffff;
    color: #475569;
    border: 1.5px solid #dbe3ec;
    border-radius: 10px;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 700;
    min-width: 95px;
    min-height: 36px;
}
QPushButton#btn_prev:hover:enabled,
QPushButton#btn_next:hover:enabled {
    background-color: #eff6ff;
    border-color: #93c5fd;
    color: #0077B6;
}
QPushButton#btn_prev:disabled,
QPushButton#btn_next:disabled {
    background-color: #f1f5f9;
    color: #cbd5e1;
    border-color: #e6ebf2;
}
QLabel#page_info {
    color: #475569;
    font-size: 12px;
    font-weight: 700;
    background: transparent;
    padding: 0 16px;
}
QLabel#total_info {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}

/* ══════════════ ACTIONS (footer) ══════════════ */
QFrame#actions_frame {
    background-color: #ffffff;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    border: none;
}
QLabel#hint_selection {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}
QPushButton#btn_view {
    background-color: #eff6ff;
    color: #0077B6;
    border: 1px solid #dbeafe;
    border-radius: 10px;
    padding: 9px 20px;
    font-size: 12px;
    font-weight: 700;
    min-height: 38px;
}
QPushButton#btn_view:hover:enabled {
    background-color: #dbeafe;
    border-color: #93c5fd;
}
QPushButton#btn_view:disabled {
    background-color: #f8fafc;
    color: #cbd5e1;
    border-color: #e6ebf2;
}

/* ══════════════ SCROLLBAR ══════════════ */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 32px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover { background: #94a3b8; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: transparent;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}
</string>
