 <widget class="QDialog" name="Dialog">
  <property name="geometry"><rect><x>0</x><y>0</y><width>960</width><height>720</height></rect></property>
  <property name="windowTitle"><string>Fiche client — Nova Pharma</string></property>
  <property name="minimumSize"><size><width>900</width><height>640</height></size></property>
  <property name="styleSheet">
   <string notr="true">/* ============================================================
   NOVA PHARMA — FICHE CLIENT
   ============================================================ */

QDialog { background-color: #f0f4f8; }

QWidget {
    font-family: "Segoe UI", "Inter", "Roboto", sans-serif;
    font-size: 13px;
    color: #0f172a;
    outline: none;
}

/* ══════════════ HEADER ══════════════ */
QFrame#header_frame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #023E8A, stop:0.4 #0077B6, stop:1 #00B4D8);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border: none;
}
QLabel#avatar {
    background: rgba(255,255,255,0.20);
    border: 2px solid rgba(255,255,255,0.40);
    border-radius: 32px;
    color: #ffffff;
    font-size: 22px;
    font-weight: 800;
    qproperty-alignment: 'AlignCenter';
}
QLabel#header_name {
    color: #ffffff;
    font-size: 22px;
    font-weight: 800;
    background: transparent;
    letter-spacing: -0.3px;
}
QLabel#header_numero {
    color: #CAF0F8;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
    font-family: "Courier New", monospace;
}
QLabel#header_badge_anon {
    background-color: #fef3c7;
    color: #92400e;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    border-radius: 10px;
    padding: 5px 12px;
}
QLabel#header_badge_active {
    background-color: #dcfce7;
    color: #15803d;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    border-radius: 10px;
    padding: 5px 12px;
}
QLabel#header_badge_inactive {
    background-color: #f1f5f9;
    color: #64748b;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    border-radius: 10px;
    padding: 5px 12px;
}

/* ══════════════ CARTE ══════════════ */
QFrame#card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-top: none;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

/* ══════════════ CARTES STATS ══════════════ */
QFrame#stat_total {
    background-color: #eff6ff;
    border: 1.5px solid #dbeafe;
    border-left: 4px solid #2563eb;
    border-radius: 14px;
}
QLabel#stat_total_label {
    color: #1e40af;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    background: transparent;
}
QLabel#stat_total_value {
    color: #1e40af;
    font-size: 22px;
    font-weight: 800;
    background: transparent;
}

QFrame#stat_visits {
    background-color: #f0fdf4;
    border: 1.5px solid #bbf7d0;
    border-left: 4px solid #16a34a;
    border-radius: 14px;
}
QLabel#stat_visits_label {
    color: #15803d;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    background: transparent;
}
QLabel#stat_visits_value {
    color: #16a34a;
    font-size: 22px;
    font-weight: 800;
    background: transparent;
}

QFrame#stat_last {
    background-color: #fff7ed;
    border: 1.5px solid #fed7aa;
    border-left: 4px solid #ea580c;
    border-radius: 14px;
}
QLabel#stat_last_label {
    color: #9a3412;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    background: transparent;
}
QLabel#stat_last_value {
    color: #ea580c;
    font-size: 18px;
    font-weight: 800;
    background: transparent;
}

/* ══════════════ SECTION TITLES ══════════════ */
QLabel#section_title {
    color: #334155;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    background: transparent;
}

/* ══════════════ COORDONNÉES ══════════════ */
QFrame#coord_box {
    background-color: #f8fafc;
    border: 1.5px solid #e6ebf2;
    border-radius: 12px;
}
QLabel#coord_key {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 700;
    background: transparent;
    letter-spacing: 0.5px;
}
QLabel#coord_val {
    color: #1e293b;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}
QLabel#coord_val_muted {
    color: #cbd5e1;
    font-size: 13px;
    font-weight: 500;
    font-style: italic;
    background: transparent;
}

/* ══════════════ TABLE HISTORIQUE ══════════════ */
QTableWidget#history_table {
    background-color: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 12px;
    gridline-color: transparent;
    outline: none;
    color: #334155;
    font-size: 12px;
}
QTableWidget#history_table::item {
    padding: 10px 8px;
    border-bottom: 1px solid #f1f5f9;
    color: #334155;
}
QTableWidget#history_table::item:hover {
    background-color: #f8fafc;
}
QTableWidget#history_table::item:selected {
    background-color: #eff6ff;
    color: #0077B6;
}
QHeaderView { background-color: transparent; border: none; }
QHeaderView::section {
    background-color: #f8fafc;
    color: #94a3b8;
    padding: 12px 10px;
    border: none;
    border-bottom: 2px solid #e6ebf2;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
}
QTableCornerButton::section { background-color: #f8fafc; border: none; }

/* ══════════════ FOOTER ══════════════ */
QFrame#footer_frame {
    background-color: #f8fafc;
    border-top: 1px solid #eef2f7;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

QPushButton#btn_close {
    background-color: #ffffff;
    color: #64748b;
    border: 1.5px solid #dbe3ec;
    border-radius: 11px;
    padding: 11px 26px;
    font-size: 13px;
    font-weight: 600;
    min-width: 120px;
    min-height: 42px;
}
QPushButton#btn_close:hover {
    background-color: #f8fafc;
    color: #0f172a;
    border-color: #c3cedd;
}

QPushButton#btn_edit {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0077B6, stop:1 #00B4D8);
    color: #ffffff;
    border: none;
    border-radius: 11px;
    padding: 11px 26px;
    font-size: 13px;
    font-weight: 800;
    min-width: 150px;
    min-height: 42px;
}
QPushButton#btn_edit:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #023E8A, stop:1 #0077B6);
}

QPushButton#btn_delete {
    background-color: #ffffff;
    color: #dc2626;
    border: 1.5px solid #fecaca;
    border-radius: 11px;
    padding: 11px 22px;
    font-size: 13px;
    font-weight: 700;
    min-width: 130px;
    min-height: 42px;
}
QPushButton#btn_delete:hover {
    background-color: #fef2f2;
    border-color: #fca5a5;
    color: #b91c1c;
}

/* ══════════════ SCROLLBAR ══════════════ */
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background-color: #ffffff; }
QScrollBar:vertical {
    border: none; background: transparent; width: 10px; margin: 2px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1; min-height: 32px; border-radius: 5px;
}
QScrollBar::handle:vertical:hover { background: #94a3b8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
</string>
