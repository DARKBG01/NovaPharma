  <property name="styleSheet">
   <string notr="true">/* ==================================================================
   NOVA PHARMA — LOGIN DESIGN SYSTEM v3
   ------------------------------------------------------------------
   Palette
     Fond droit      : #f4f6fb
     Carte formulaire: #ffffff / bordure #e6ebf2 / rayon 20px
     Sidebar         : #0b1220 -&gt; #16233d (navy profond)
     Primaire        : #2563eb (hover #1d4ed8, pressed #1e40af)
     Texte           : #0f172a / #475569 / #94a3b8
     Succès          : #16a34a / fond #f0fdf4 / bord #bbf7d0
   ================================================================== */

QDialog {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0.4, y2:1,
                                      stop:0 #f6f8fc, stop:1 #eef2f7);
}

QWidget {
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;, &quot;Roboto&quot;, &quot;Helvetica Neue&quot;, sans-serif;
    font-size: 14px;
    color: #0f172a;
    outline: none;
    selection-background-color: #bfdbfe;
    selection-color: #0f172a;
}

QLabel { background-color: transparent; border: none; color: #1e293b; }

QToolTip {
    background-color: #0f172a;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* --------------------------- SIDEBAR --------------------------- */
QFrame#frameSidebar {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0.7, y2:1,
                                      stop:0 #0b1220, stop:0.55 #101c33, stop:1 #1d4ed8);
    border: none;
}
QFrame#frameSidebar QLabel { background-color: transparent; }

/* Pastille icône principale (verre dépoli) */
QLabel#labelIconContainer {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1,
                                      stop:0 rgba(59, 130, 246, 90),
                                      stop:1 rgba(37, 99, 235, 55));
    border: 1px solid rgba(255, 255, 255, 45);
    border-radius: 20px;
    padding: 15px;
}

QLabel#labelTitle {
    color: #ffffff;
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -0.6px;
}

QLabel#labelDesc {
    color: #bfdbfe;
    font-size: 14px;
    font-weight: 500;
}

/* Liste de features sidebar */
QFrame#frameFeatureRow {
    background-color: transparent;
    border: none;
}
QLabel#labelFeatureIcon {
    background-color: rgba(59, 130, 246, 40);
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 10px;
    padding: 6px;
}
QLabel#labelFeatureText {
    color: #e0e7ff;
    font-size: 13px;
    font-weight: 500;
}

/* Badge d'information (carte verre) */
QFrame#frameBadgeInfo {
    background-color: rgba(255, 255, 255, 16);
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 16px;
}
QLabel#labelBadgeIcon {
    background-color: rgba(59, 130, 246, 60);
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 8px;
    padding: 5px;
}
QLabel#labelBadgeTitle {
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
}
QLabel#labelBadgeText {
    color: #93c5fd;
    font-size: 12px;
    font-weight: 500;
}

QLabel#labelVersion {
    color: rgba(255, 255, 255, 110);
    font-size: 11px;
    font-weight: 500;
}

/* ---------------------- COLONNE FORMULAIRE ---------------------- */
QFrame#frameFormContainer { background-color: transparent; border: none; }

/* Carte principale */
QFrame#frameFormFields {
    background-color: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 20px;
}

QLabel#labelHeader {
    font-size: 26px;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.4px;
}

QLabel#labelSubheader {
    font-size: 13px;
    font-weight: 500;
    color: #64748b;
}

QLabel#labelUser, QLabel#labelPassword {
    font-size: 11px;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 0.8px;
}

QLabel#labelForgot {
    color: #2563eb;
    font-size: 12px;
    font-weight: 700;
}
QLabel#labelForgot:hover { color: #1d4ed8; }

QLabel#labelHelp { color: #64748b; font-size: 13px; }

/* ------------------------- CHAMPS DE SAISIE ------------------------- */
QFrame#frameUsernameField, QFrame#framePasswordField {
    background-color: #ffffff;
    border: 1px solid #dbe3ec;
    border-radius: 12px;
}
QFrame#frameUsernameField:hover, QFrame#framePasswordField:hover {
    border: 1px solid #b9c6d8;
}
QFrame#frameUsernameField[focused=&quot;true&quot;],
QFrame#framePasswordField[focused=&quot;true&quot;] {
    border: 1px solid #2563eb;
    background-color: #ffffff;
}

QLineEdit#lineEdit_username, QLineEdit#lineEdit_password {
    background-color: transparent;
    border: none;
    padding: 0;
    font-size: 14px;
    font-weight: 500;
    color: #0f172a;
    selection-background-color: #bfdbfe;
    selection-color: #0f172a;
}

QToolButton#btn_toggle_pwd {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
}
QToolButton#btn_toggle_pwd:hover {
    background-color: #eff6ff;
}

/* ----------------------------- BOUTON ----------------------------- */
QPushButton#pushButton_login {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #3b82f6, stop:1 #2563eb);
    color: #ffffff;
    border: 1px solid #1d4ed8;
    border-radius: 12px;
    padding: 14px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.2px;
}
QPushButton#pushButton_login:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #2f74e8, stop:1 #1d4ed8);
    border: 1px solid #1e40af;
}
QPushButton#pushButton_login:pressed {
    background-color: #1e40af;
    border: 1px solid #1e3a8a;
}
QPushButton#pushButton_login:disabled {
    background-color: #cbd5e1;
    border: 1px solid #cbd5e1;
    color: #f8fafc;
}

/* ---------------------------- CHECKBOX ---------------------------- */
QCheckBox {
    spacing: 10px;
    font-size: 13px;
    font-weight: 500;
    color: #475569;
    background-color: transparent;
}
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 1px solid #cbd5e1;
    background-color: #ffffff;
}
QCheckBox::indicator:hover { border: 1px solid #2563eb; }
QCheckBox::indicator:checked {
    background-color: #2563eb;
    border: 1px solid #2563eb;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAiIGhlaWdodD0iOCIgdmlld0JveD0iMCAwIDEwIDgiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PHBhdGggZD0iTTEgNEwzLjUgNi41TDkgMSIgc3Ryb2tlPSJ3aGl0ZSIgc3Ryb2tlLXdpZHRoPSIyIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz48L3N2Zz4=);
}
QCheckBox::indicator:checked:hover {
    background-color: #1d4ed8;
    border: 1px solid #1d4ed8;
}

/* ------------------------ BANNIÈRE ERREUR ------------------------ */
QFrame#frameError {
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    border-left: 4px solid #dc2626;
    border-radius: 10px;
}
QLabel#labelErrorText {
    color: #991b1b;
    font-size: 12px;
    font-weight: 500;
}

/* --------------------------- SÉPARATEUR --------------------------- */
QFrame#frameDivider {
    background-color: #eef2f7;
    border: none;
    max-height: 1px;
}

/* ------------------------- FOOTER / LEGAL ------------------------- */
QFrame#frameLegal {
    background-color: #f8fafc;
    border: none;
    border-top: 1px solid #e6ebf2;
}
QLabel#labelLegalText {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 500;
}
QLabel#labelLegalIcon {
    background-color: transparent;
    padding: 0;
}
</string>
