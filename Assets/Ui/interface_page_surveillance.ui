  <property name="styleSheet">
   <string notr="true">
#PageSurveillance { background: transparent; }
QLabel { background: transparent; }
#header_surv {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1,
        stop:0 #7c2d12, stop:1 #b91c1c);
    border-radius: 18px;
    border: 1px solid #7f1d1d;
}
#header_surv QLabel { color: #ffffff; }
#ico_surv {
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 14px;
    padding: 10px;
}
#label_surv_title { font-size: 22px; font-weight: 800; }
#label_surv_sub { font-size: 11px; color: rgba(255,255,255,0.8); }
#badge_surv {
    background: rgba(255,255,255,0.2);
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 12px;
    padding: 8px 18px;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
}
QFrame#card_surv {
    background: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 16px;
}
QLabel#kpi_label_surv {
    color: #64748b;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
}
QLabel#kpi_total_surv {
    color: #0f172a;
    font-size: 24px;
    font-weight: 800;
}
QLabel#kpi_alertes_surv {
    color: #b45309;
    font-size: 24px;
    font-weight: 800;
}
QLabel#kpi_critiques_surv {
    color: #dc2626;
    font-size: 24px;
    font-weight: 800;
}
QLabel#kpi_chain_surv {
    color: #16a34a;
    font-size: 24px;
    font-weight: 800;
}

QPushButton#btn_surv_primary {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #dc2626, stop:1 #991b1b);
    color: #ffffff;
    border: 1px solid #7f1d1d;
    border-radius: 11px;
    padding: 10px 20px;
    font-weight: 800;
}
QPushButton#btn_surv_primary:hover { background: #7f1d1d; }
QPushButton#btn_surv_ghost {
    background: #ffffff;
    color: #475569;
    border: 1.5px solid #dbe3ec;
    border-radius: 11px;
    padding: 10px 20px;
    font-weight: 700;
}
QPushButton#btn_surv_ghost:hover { background: #f8fafc; }

QComboBox#combo_surv_sev {
    background: #ffffff;
    border: 1px solid #dbe3ec;
    border-radius: 10px;
    padding: 8px 14px;
}

QComboBox::drop-down ,QDateEdit::drop-down { border: none; width: 26px; }
QComboBox::drop-down ,QDateEdit::down-arrow {
    image: url(:/Icon/Icons/chevron-down.svg);
    width: 12px; height: 12px;
}

QLineEdit#inp_surv_search {
    background: #ffffff;
    border: 1px solid #dbe3ec;
    border-radius: 10px;
    padding: 8px 14px;
    min-height: 22px;
}
QDateEdit#date_surv_debut, QDateEdit#date_surv_fin {
    background: #ffffff;
    border: 1px solid #dbe3ec;
    border-radius: 10px;
    padding: 6px 10px;
    min-height: 22px;
}

QTableWidget#table_surv {
    background: transparent;
    border: none;
    gridline-color: #f1f5f9;
}
QTableWidget#table_surv::item {
    padding: 10px;
    border-bottom: 1px solid #f1f5f9;
}
QTableWidget#table_surv::item:selected {
    background: #eff6ff;
    color: #1d4ed8;
}
QHeaderView::section {
    background: #f8fafc;
    color: #94a3b8;
    padding: 12px;
    border: none;
    border-bottom: 1px solid #e6ebf2;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
}
