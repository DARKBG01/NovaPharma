  <property name="windowTitle">
   <string>Nouveau produit — Nova Pharma</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* ============================================================
   NOVA PHARMA — DIALOG AJOUT PRODUIT
   ============================================================ */

QDialog { background-color: #f0f4f8; }

QWidget {
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;, &quot;Roboto&quot;, sans-serif;
    font-size: 13px;
    color: #0f172a;
    outline: none;
}

/* ══════════════ SIDEBAR ══════════════ */
QFrame#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0.7, y2:1,
        stop:0 #023E8A, stop:0.5 #0077B6, stop:1 #00B4D8);
    border: none;
    border-top-left-radius: 16px;
    border-bottom-left-radius: 16px;
}

QLabel#brand_badge {
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.28);
    border-radius: 14px;
    padding: 6px 14px;
}

QLabel#sidebar_title {
    color: #ffffff;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.5px;
    background: transparent;
}

QLabel#sidebar_lead {
    color: #CAF0F8;
    font-size: 13px;
    font-weight: 400;
    background: transparent;
}

QFrame#check_row {
    background: rgba(255,255,255,0.10);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 12px;
}
QFrame#check_row[done=&quot;true&quot;] {
    background: rgba(255,255,255,0.25);
    border: 1px solid rgba(255,255,255,0.40);
}
QLabel#check_text {
    color: #e0e7ff;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}
QFrame#check_row[done=&quot;true&quot;] QLabel#check_text {
    color: #ffffff;
}

QLabel#progress_label {
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    background: transparent;
    min-width: 45px;
    qproperty-alignment: 'AlignRight | AlignVCenter';
}
QProgressBar#progress_bar {
    background-color: rgba(255,255,255,0.18);
    border: none;
    border-radius: 5px;
    height: 10px;
    max-height: 10px;
    text-align: center;
}
QProgressBar#progress_bar::chunk {
    background-color: #90E0EF;
    border-radius: 5px;
}

QLabel#sidebar_footer {
    color: rgba(255,255,255,0.65);
    font-size: 11px;
    background: transparent;
}

/* ══════════════ PANEL ══════════════ */
QFrame#panel {
    background-color: #ffffff;
    border: 1px solid #e6ebf2;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
}

QLabel#panel_title {
    color: #0f172a;
    font-size: 20px;
    font-weight: 800;
    background: transparent;
}
QLabel#panel_subtitle {
    color: #64748b;
    font-size: 12px;
    background: transparent;
}

/* Section numbers */
QLabel#section_num {
    background-color: #e0f7fa;
    color: #0077B6;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 800;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
    qproperty-alignment: 'AlignCenter';
}
QLabel#section_title {
    color: #334155;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    background: transparent;
}

/* Labels de champs */
QLabel#field_label {
    color: #334155;
    font-size: 12px;
    font-weight: 700;
    background: transparent;
}
QLabel#field_required {
    color: #dc2626;
    font-size: 13px;
    font-weight: 800;
    background: transparent;
}
QLabel#field_opt {
    color: #0077B6;
    font-size: 10px;
    font-weight: 700;
    background-color: #e0f7fa;
    border-radius: 8px;
    padding: 2px 8px;
}

/* Inputs */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #f8fafc;
    border: 1.5px solid #dbe3ec;
    border-radius: 11px;
    padding: 10px 14px;
    color: #0f172a;
    font-size: 13px;
    font-weight: 500;
    selection-background-color: #bfdbfe;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #b9c6d8;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    background-color: #ffffff;
    border: 1.5px solid #0077B6;
}
QLineEdit[readOnly=&quot;true&quot;], QDoubleSpinBox[readOnly=&quot;true&quot;] {
    background-color: #f1f5f9;
    color: #475569;
}

QComboBox::drop-down { border: none; width: 26px; }
QComboBox::down-arrow {
    image: url(:/Icon/Icons/chevron-down.svg);
    width: 12px; height: 12px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 10px;
    padding: 6px;
    selection-background-color: #eff6ff;
    selection-color: #0077B6;
    outline: none;
}

/* Compteur du nom */
QLabel#name_counter {
    color: #0077B6;
    font-size: 11px;
    font-weight: 700;
    background-color: #e0f7fa;
    border: 1px solid #bae6fd;
    border-radius: 10px;
    padding: 3px 10px;
}

/* Aperçu code-barre */
QFrame#barcode_preview {
    background-color: #fbfcfe;
    border: 1px dashed #dbe3ec;
    border-radius: 10px;
    min-height: 44px;
    max-height: 44px;
}
QLabel#barcode_hint {
    color: #94a3b8;
    font-size: 11px;
    background: transparent;
    qproperty-alignment: 'AlignCenter';
}

/* Toggle auto */
QFrame#auto_box {
    background-color: #f0f9ff;
    border: 1.5px solid #bae6fd;
    border-radius: 12px;
    min-height: 54px;
}
QFrame#auto_box[on=&quot;true&quot;] {
    background-color: #e0f7fa;
    border: 1.5px solid #00B4D8;
}
QCheckBox#auto_check {
    color: #0369a1;
    font-size: 13px;
    font-weight: 700;
    spacing: 10px;
    background: transparent;
}
QCheckBox#auto_check::indicator {
    width: 20px; height: 20px;
    border: 2px solid #bae6fd;
    border-radius: 10px;
    background-color: #ffffff;
}
QCheckBox#auto_check::indicator:checked {
    background-color: #0077B6;
    border: 2px solid #0077B6;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iOCIgaGVpZ2h0PSI4IiB2aWV3Qm94PSIwIDAgOCA4IiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjxjaXJjbGUgY3g9IjQiIGN5PSI0IiByPSIyIiBmaWxsPSJ3aGl0ZSIvPjwvc3ZnPg==);
}
QLabel#auto_hint {
    color: #0284c7;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}

/* Totaux */
QFrame#tot_buy_card {
    background-color: #f8fafc;
    border: 1.5px solid #e6ebf2;
    border-left: 4px solid #0077B6;
    border-radius: 14px;
    min-height: 90px;
}
QFrame#tot_sell_card {
    background-color: #f8fafc;
    border: 1.5px solid #e6ebf2;
    border-left: 4px solid #16A34A;
    border-radius: 14px;
    min-height: 90px;
}
QLabel#tot_buy_label, QLabel#tot_sell_label {
    color: #64748b;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    background: transparent;
}
QLabel#tot_buy_value {
    color: #023E8A;
    font-size: 22px;
    font-weight: 800;
    background: transparent;
}
QLabel#tot_sell_value {
    color: #16A34A;
    font-size: 22px;
    font-weight: 800;
    background: transparent;
}

QLabel#margin_label, QLabel#profit_label {
    color: #64748b;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}
QLabel#margin_value, QLabel#profit_value {
    color: #0077B6;
    font-size: 13px;
    font-weight: 800;
    background: transparent;
}

/* Erreur */
QLabel#label_error {
    color: #dc2626;
    font-size: 12px;
    font-weight: 600;
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    border-left: 4px solid #dc2626;
    border-radius: 10px;
    padding: 10px 14px;
}

/* Footer */
QFrame#panel_footer {
    background-color: #f8fafc;
    border-top: 1px solid #eef2f7;
    border-bottom-right-radius: 16px;
}

QPushButton#btn_cancel {
    background-color: #ffffff;
    color: #64748b;
    border: 1.5px solid #dbe3ec;
    border-radius: 11px;
    padding: 12px 26px;
    font-size: 13px;
    font-weight: 600;
    min-width: 120px;
    min-height: 44px;
}
QPushButton#btn_cancel:hover {
    background-color: #fef2f2;
    color: #dc2626;
    border-color: #fecaca;
}

QPushButton#btn_save {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0077B6, stop:1 #00B4D8);
    color: #ffffff;
    border: none;
    border-radius: 11px;
    padding: 12px 30px;
    font-size: 13px;
    font-weight: 800;
    min-width: 190px;
    min-height: 44px;
    letter-spacing: 0.3px;
}
QPushButton#btn_save:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #023E8A, stop:1 #0077B6);
}
QPushButton#btn_save:pressed { background: #023E8A; }
QPushButton#btn_save:disabled { background: #cbd5e1; color: #94a3b8; }

QPushButton#btn_gen_ref {
    background-color: #eff6ff;
    color: #0077B6;
    border: 1px solid #bae6fd;
    border-radius: 9px;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 700;
}
QPushButton#btn_gen_ref:hover {
    background-color: #dbeafe;
    border-color: #93c5fd;
}

/* ScrollArea */
QScrollArea {
    background-color: transparent;
    border: none;
}
QScrollArea &gt; QWidget &gt; QWidget {
    background-color: #ffffff;
}
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 32px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover { background: #94a3b8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px; background: transparent;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}
</string>
