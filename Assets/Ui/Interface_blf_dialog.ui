<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Dialog</class>
 <widget class="QDialog" name="Dialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1200</width><height>780</height></rect>
  </property>
  <property name="windowTitle"><string>Nouveau Bon de Livraison — Nova Pharma</string></property>
  <property name="minimumSize"><size><width>1100</width><height>700</height></size></property>
  <property name="styleSheet">
   <string notr="true">/* ============================================================
   NOVA PHARMA — DIALOG BLF
   ============================================================ */

QDialog { background-color: #f0f4f8; }

QWidget {
    font-family: "Segoe UI", "Inter", "Roboto", sans-serif;
    font-size: 13px;
    color: #0f172a;
    outline: none;
}

/* ══════════ PANNEAU CATALOGUE (gauche) ══════════ */
QFrame#panel_catalogue {
    background-color: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 18px;
}
QLabel#catalogue_title {
    color: #0f172a;
    font-size: 16px;
    font-weight: 800;
    background: transparent;
}
QLabel#catalogue_subtitle {
    color: #94a3b8;
    font-size: 11px;
    background: transparent;
}
QLineEdit#search_produit {
    background-color: #f8fafc;
    border: 1.5px solid #dbe3ec;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 13px;
    color: #0f172a;
}
QLineEdit#search_produit:focus {
    background-color: #ffffff;
    border-color: #0077B6;
}
QTableWidget#table_produits {
    background-color: #ffffff;
    alternate-background-color: #fbfcfe;
    border: 1px solid #e6ebf2;
    border-radius: 10px;
    gridline-color: transparent;
    outline: none;
    color: #334155;
}
QTableWidget#table_produits::item {
    padding: 8px 6px;
    border-bottom: 1px solid #f1f5f9;
}
QTableWidget#table_produits::item:selected {
    background-color: #eff6ff;
    color: #0077B6;
}
QHeaderView::section {
    background-color: #f8fafc;
    color: #94a3b8;
    padding: 10px 8px;
    border: none;
    border-bottom: 2px solid #e6ebf2;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
}

/* ══════════ PANNEAU BLF (droite) ══════════ */
QFrame#panel_blf {
    background-color: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 18px;
}

QFrame#blf_header {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #023E8A, stop:0.4 #0077B6, stop:1 #00B4D8);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border: none;
}
QLabel#blf_header_title {
    color: #ffffff;
    font-size: 20px;
    font-weight: 800;
    background: transparent;
}
QLabel#blf_header_subtitle {
    color: #CAF0F8;
    font-size: 12px;
    background: transparent;
}
QLabel#blf_header_icon {
    background-color: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 14px;
    padding: 10px;
}

/* Champs */
QLabel#field_label {
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    background: transparent;
}
QComboBox#combo_fournisseur,
QLineEdit#edit_ref_externe,
QLineEdit#edit_notes {
    background-color: #f8fafc;
    border: 1.5px solid #dbe3ec;
    border-radius: 10px;
    padding: 10px 14px;
    color: #0f172a;
    font-size: 13px;
    font-weight: 500;
}
QComboBox#combo_fournisseur:focus,
QLineEdit#edit_ref_externe:focus,
QLineEdit#edit_notes:focus {
    background-color: #ffffff;
    border-color: #0077B6;
}
QComboBox#combo_fournisseur::drop-down { border: none; width: 26px; }
QComboBox#combo_fournisseur::down-arrow {
    image: url(:/Icon/Icons/chevron-down.svg);
    width: 12px; height: 12px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 10px;
    padding: 6px;
    selection-background-color: #eff6ff;
    selection-color: #0077B6;
}

/* Zone scrollable lignes */
QScrollArea#scroll_lignes {
    background-color: transparent;
    border: none;
}
QWidget#scroll_content {
    background-color: transparent;
}
QLabel#label_empty {
    color: #94a3b8;
    font-size: 12px;
    font-style: italic;
    background-color: #fbfcfe;
    border: 1px dashed #dbe3ec;
    border-radius: 12px;
    padding: 30px;
    qproperty-alignment: 'AlignCenter';
}

/* Totaux */
QFrame#total_box {
    background-color: #eff6ff;
    border: 1.5px solid #dbeafe;
    border-left: 4px solid #0077B6;
    border-radius: 12px;
}
QLabel#label_nb_articles {
    color: #1e40af;
    font-size: 12px;
    font-weight: 700;
    background: transparent;
}
QLabel#label_total_caption {
    color: #1e40af;
    font-size: 13px;
    font-weight: 800;
    background: transparent;
}
QLabel#label_total_value {
    color: #023E8A;
    font-size: 18px;
    font-weight: 800;
    background: transparent;
}

/* Footer */
QFrame#blf_footer {
    background-color: #f8fafc;
    border-top: 1px solid #eef2f7;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}

QPushButton#btn_cancel {
    background-color: #ffffff;
    color: #64748b;
    border: 1.5px solid #dbe3ec;
    border-radius: 10px;
    padding: 10px 24px;
    font-size: 13px;
    font-weight: 600;
    min-width: 110px;
    min-height: 42px;
}
QPushButton#btn_cancel:hover {
    background-color: #fef2f2;
    color: #dc2626;
    border-color: #fecaca;
}

QPushButton#btn_draft {
    background-color: #ffffff;
    color: #0077B6;
    border: 1.5px solid #bae6fd;
    border-radius: 10px;
    padding: 10px 22px;
    font-size: 13px;
    font-weight: 700;
    min-height: 42px;
}
QPushButton#btn_draft:hover { background-color: #eff6ff; }

QPushButton#btn_validate {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0077B6, stop:1 #00B4D8);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 10px 28px;
    font-size: 13px;
    font-weight: 800;
    min-width: 220px;
    min-height: 42px;
}
QPushButton#btn_validate:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #023E8A, stop:1 #0077B6);
}

/* Scrollbar */
QScrollBar:vertical {
    border: none; background: transparent;
    width: 10px; margin: 2px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1; min-height: 32px; border-radius: 5px;
}
QScrollBar::handle:vertical:hover { background: #94a3b8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
</string>
  </property>

  <layout class="QHBoxLayout" name="root_layout">
   <property name="spacing"><number>20</number></property>
   <property name="leftMargin"><number>20</number></property>
   <property name="topMargin"><number>20</number></property>
   <property name="rightMargin"><number>20</number></property>
   <property name="bottomMargin"><number>20</number></property>

   <!-- ══════════════ CATALOGUE PRODUITS ══════════════ -->
   <item>
    <widget class="QFrame" name="panel_catalogue">
     <property name="minimumSize"><size><width>420</width><height>0</height></size></property>
     <property name="maximumSize"><size><width>460</width><height>16777215</height></size></property>
     <property name="frameShape"><enum>QFrame::Shape::NoFrame</enum></property>
     <layout class="QVBoxLayout" name="catalogue_layout">
      <property name="spacing"><number>12</number></property>
      <property name="leftMargin"><number>20</number></property>
      <property name="topMargin"><number>20</number></property>
      <property name="rightMargin"><number>20</number></property>
      <property name="bottomMargin"><number>20</number></property>

      <item>
       <widget class="QLabel" name="catalogue_title">
