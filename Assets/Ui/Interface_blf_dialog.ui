               <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
              </spacer>
             </item>
            </layout>
           </widget>
          </widget>
         </item>

         <!-- Message vide -->
         <item>
          <widget class="QLabel" name="label_empty">
           <property name="text"><string>Aucun produit dans le BLF.
Double-cliquez sur un produit à gauche pour l'ajouter.</string></property>
           <property name="alignment"><set>Qt::AlignmentFlag::AlignCenter</set></property>
          </widget>
         </item>

