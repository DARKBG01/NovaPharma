            <widget class="QLabel" name="blf_header_subtitle">
             <property name="text"><string>Créé par Utilisateur — Date</string></property>
            </widget>
           </item>
          </layout>
         </item>

         <item>
          <spacer name="blf_header_spacer">
           <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
          </spacer>
         </item>
        </layout>
       </widget>
      </item>

      <!-- Contenu -->
      <item>
       <widget class="QWidget" name="blf_content">
        <property name="styleSheet"><string notr="true">background-color: #ffffff;</string></property>
        <layout class="QVBoxLayout" name="blf_content_layout">
         <property name="spacing"><number>14</number></property>
         <property name="leftMargin"><number>24</number></property>
         <property name="topMargin"><number>20</number></property>
         <property name="rightMargin"><number>24</number></property>
         <property name="bottomMargin"><number>20</number></property>

         <!-- Fournisseur + Ref externe -->
         <item>
          <layout class="QHBoxLayout" name="fournisseur_row">
           <property name="spacing"><number>12</number></property>

           <item>
            <layout class="QVBoxLayout" name="fournisseur_layout">
             <property name="spacing"><number>4</number></property>
             <item>
              <widget class="QLabel" name="label_fournisseur">
               <property name="text"><string>Fournisseur</string></property>
               <property name="styleSheet"><string notr="true">color: #64748b; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; background: transparent;</string></property>
              </widget>
             </item>
             <item>
              <widget class="QComboBox" name="combo_fournisseur">
