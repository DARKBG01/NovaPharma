       </widget>
      </item>

      <item>
       <widget class="QLabel" name="catalogue_subtitle">
        <property name="text"><string>Double-cliquez pour ajouter au BLF</string></property>
       </widget>
      </item>

      <item>
       <widget class="QLineEdit" name="search_produit">
        <property name="placeholderText"><string>Rechercher un produit…</string></property>
        <property name="clearButtonEnabled"><bool>true</bool></property>
       </widget>
      </item>

      <item>
       <widget class="QTableWidget" name="table_produits">
        <property name="editTriggers"><set>QAbstractItemView::EditTrigger::NoEditTriggers</set></property>
        <property name="selectionBehavior"><enum>QAbstractItemView::SelectionBehavior::SelectRows</enum></property>
        <property name="selectionMode"><enum>QAbstractItemView::SelectionMode::SingleSelection</enum></property>
        <property name="alternatingRowColors"><bool>true</bool></property>
        <property name="showGrid"><bool>false</bool></property>
        <property name="verticalScrollMode"><enum>QAbstractItemView::ScrollMode::ScrollPerPixel</enum></property>
        <attribute name="verticalHeaderVisible"><bool>false</bool></attribute>
        <attribute name="verticalHeaderDefaultSectionSize"><number>40</number></attribute>
        <column><property name="text"><string>Code</string></property></column>
        <column><property name="text"><string>Produit</string></property></column>
        <column><property name="text"><string>Stock</string></property></column>
        <column><property name="text"><string>Prix</string></property></column>
       </widget>
      </item>

     </layout>
    </widget>
   </item>

   <!-- ══════════════ BLF ══════════════ -->
   <item>
    <widget class="QFrame" name="panel_blf">
     <property name="frameShape"><enum>QFrame::Shape::NoFrame</enum></property>
     <layout class="QVBoxLayout" name="blf_layout">
      <property name="spacing"><number>0</number></property>
      <property name="leftMargin"><number>0</number></property>
      <property name="topMargin"><number>0</number></property>
      <property name="rightMargin"><number>0</number></property>
      <property name="bottomMargin"><number>0</number></property>

      <!-- Header gradient -->
      <item>
       <widget class="QFrame" name="blf_header">
        <property name="minimumSize"><size><width>0</width><height>90</height></size></property>
        <property name="maximumSize"><size><width>16777215</width><height>90</height></size></property>
        <property name="frameShape"><enum>QFrame::Shape::NoFrame</enum></property>
        <layout class="QHBoxLayout" name="blf_header_layout">
         <property name="leftMargin"><number>28</number></property>
         <property name="topMargin"><number>16</number></property>
         <property name="rightMargin"><number>28</number></property>
         <property name="bottomMargin"><number>16</number></property>
         <property name="spacing"><number>16</number></property>

         <item>
          <widget class="QLabel" name="blf_header_icon">
           <property name="minimumSize"><size><width>48</width><height>48</height></size></property>
           <property name="maximumSize"><size><width>48</width><height>48</height></size></property>
           <property name="pixmap"><pixmap resource="../Icon.qrc">:/Icon/Icons/package_white.svg</pixmap></property>
           <property name="scaledContents"><bool>true</bool></property>
          </widget>
         </item>

         <item>
          <layout class="QVBoxLayout" name="blf_header_text">
           <property name="spacing"><number>4</number></property>
           <item>
            <widget class="QLabel" name="blf_header_title">
             <property name="text"><string>Nouveau Bon de Livraison</string></property>
            </widget>
           </item>
