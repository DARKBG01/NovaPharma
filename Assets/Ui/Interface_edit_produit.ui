<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>Dialog</class>
 <widget class="QDialog" name="Dialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1208</width>
    <height>820</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>980</width>
    <height>720</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>Modifier le produit — Nova Pharma</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* ============================================================
   NOVA PHARMA — DIALOG MODIFICATION PRODUIT
   ============================================================ */

QDialog { background-color: #f0f4f8; }

QWidget {
    font-family: &quot;Segoe UI&quot;, &quot;Inter&quot;, &quot;Roboto&quot;, sans-serif;
    font-size: 13px;
    color: #0f172a;
    outline: none;
}

/* ══════════════ SIDEBAR ══════════════ */
QFrame#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0.7, y2:1,
        stop:0 #023E8A, stop:0.5 #0077B6, stop:1 #00B4D8);
    border: none;
    border-top-left-radius: 16px;
    border-bottom-left-radius: 16px;
}

QFrame#brand_badge {
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.28);
    border-radius: 14px;
}
QLabel#brand_badge_text {
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    background: transparent;
}

QLabel#sidebar_title {
    color: #ffffff;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.5px;
    background: transparent;
}

QLabel#sidebar_lead {
    color: #CAF0F8;
    font-size: 13px;
    font-weight: 400;
    background: transparent;
}

/* Carte info produit (sidebar) */
QFrame#info_card {
    background: rgba(255,255,255,0.14);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 14px;
}
QLabel#info_label {
    color: #90E0EF;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1.5px;
    background: transparent;
}
QLabel#info_value {
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
}
QLabel#info_code {
    color: rgba(255,255,255,0.75);
    font-size: 11px;
    font-weight: 600;
    background: transparent;
    font-family: &quot;Courier New&quot;, monospace;
}

/* Checklist */
QFrame#check_row {
    background: rgba(255,255,255,0.10);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 12px;
}
QFrame#check_row[done=&quot;true&quot;] {
    background: rgba(255,255,255,0.25);
    border: 1px solid rgba(255,255,255,0.40);
}
QLabel#check_text {
    color: #e0e7ff;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}
QFrame#check_row[done=&quot;true&quot;] QLabel#check_text {
    color: #ffffff;
}

QLabel#progress_label {
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    background: transparent;
    min-width: 45px;
    qproperty-alignment: 'AlignRight | AlignVCenter';
}
QProgressBar#progress_bar {
    background-color: rgba(255,255,255,0.18);
    border: none;
    border-radius: 5px;
    height: 10px;
    max-height: 10px;
}
QProgressBar#progress_bar::chunk {
    background-color: #90E0EF;
    border-radius: 5px;
}

QLabel#sidebar_footer {
    color: rgba(255,255,255,0.65);
    font-size: 11px;
    background: transparent;
}

/* ══════════════ PANEL ══════════════ */
QFrame#panel {
    background-color: #ffffff;
    border: 1px solid #e6ebf2;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
}

/* Bandeau &quot;Mode édition&quot; */
QFrame#edit_banner {
    background-color: #eff6ff;
    border: 1px solid #dbeafe;
    border-left: 4px solid #0077B6;
    border-radius: 10px;
}
QLabel#edit_banner_text {
    color: #0369a1;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QLabel#panel_title {
    color: #0f172a;
    font-size: 20px;
    font-weight: 800;
    background: transparent;
}
QLabel#panel_subtitle {
    color: #64748b;
    font-size: 12px;
    background: transparent;
}

/* Sections */
QLabel#section_num {
    background-color: #e0f7fa;
    color: #0077B6;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 800;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
    qproperty-alignment: 'AlignCenter';
}
QLabel#section_title {
    color: #334155;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    background: transparent;
}

/* Labels de champs */
QLabel#field_label {
    color: #334155;
    font-size: 12px;
    font-weight: 700;
    background: transparent;
}
QLabel#field_required {
    color: #dc2626;
    font-size: 13px;
    font-weight: 800;
    background: transparent;
}
QLabel#field_opt {
    color: #0077B6;
    font-size: 10px;
    font-weight: 700;
    background-color: #e0f7fa;
    border-radius: 8px;
    padding: 2px 8px;
}
QLabel#field_lock {
    color: #64748b;
    font-size: 10px;
    font-weight: 700;
    background-color: #f1f5f9;
    border-radius: 8px;
    padding: 2px 8px;
}

/* Inputs */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #f8fafc;
    border: 1.5px solid #dbe3ec;
    border-radius: 11px;
    padding: 10px 14px;
    color: #0f172a;
    font-size: 13px;
    font-weight: 500;
    selection-background-color: #bfdbfe;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #b9c6d8;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    background-color: #ffffff;
    border: 1.5px solid #0077B6;
}
QLineEdit[readOnly=&quot;true&quot;], QDoubleSpinBox[readOnly=&quot;true&quot;] {
    background-color: #f1f5f9;
    color: #475569;
}

QComboBox::drop-down { border: none; width: 26px; }
QComboBox::down-arrow {
    image: url(:/Icon/Icons/chevron-down.svg);
    width: 12px; height: 12px;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 10px;
    padding: 6px;
    selection-background-color: #eff6ff;
    selection-color: #0077B6;
    outline: none;
}

QLabel#name_counter {
    color: #0077B6;
    font-size: 11px;
    font-weight: 700;
    background-color: #e0f7fa;
    border: 1px solid #bae6fd;
    border-radius: 10px;
    padding: 3px 10px;
}

/* Aperçu code-barre */
QFrame#barcode_preview {
    background-color: #fbfcfe;
    border: 1px dashed #dbe3ec;
    border-radius: 10px;
    min-height: 44px;
    max-height: 44px;
}
QLabel#barcode_hint {
    color: #94a3b8;
    font-size: 11px;
    background: transparent;
    qproperty-alignment: 'AlignCenter';
}

/* Toggle auto */
QFrame#auto_box {
    background-color: #f0f9ff;
    border: 1.5px solid #bae6fd;
    border-radius: 12px;
    min-height: 54px;
}
QFrame#auto_box[on=&quot;true&quot;] {
    background-color: #e0f7fa;
    border: 1.5px solid #00B4D8;
}
QCheckBox#auto_check {
    color: #0369a1;
    font-size: 13px;
    font-weight: 700;
    spacing: 10px;
    background: transparent;
}
QCheckBox#auto_check::indicator {
    width: 20px; height: 20px;
    border: 2px solid #bae6fd;
    border-radius: 10px;
    background-color: #ffffff;
}
QCheckBox#auto_check::indicator:checked {
    background-color: #0077B6;
    border: 2px solid #0077B6;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iOCIgaGVpZ2h0PSI4IiB2aWV3Qm94PSIwIDAgOCA4IiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjxjaXJjbGUgY3g9IjQiIGN5PSI0IiByPSIyIiBmaWxsPSJ3aGl0ZSIvPjwvc3ZnPg==);
}
QLabel#auto_hint {
    color: #0284c7;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}

/* Cartes marge/bénéfice */
QLabel#margin_label, QLabel#profit_label {
    color: #64748b;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}
QLabel#margin_value, QLabel#profit_value {
    color: #0077B6;
    font-size: 13px;
    font-weight: 800;
    background: transparent;
}

/* ══════ CARTES STOCK ══════ */
QFrame#stock_current_card {
    background-color: #eff6ff;
    border: 1.5px solid #dbeafe;
    border-left: 4px solid #2563eb;
    border-radius: 14px;
}
QLabel#stock_current_label {
    color: #1e40af;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    background: transparent;
}
QLabel#stock_current_value {
    color: #1e40af;
    font-size: 28px;
    font-weight: 800;
    background: transparent;
}

QFrame#stock_new_card {
    background-color: #f0fdf4;
    border: 1.5px solid #bbf7d0;
    border-left: 4px solid #16a34a;
    border-radius: 14px;
}
QLabel#stock_new_label {
    color: #15803d;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    background: transparent;
}
QLabel#stock_new_value {
    color: #16a34a;
    font-size: 28px;
    font-weight: 800;
    background: transparent;
}

QFrame#stock_diff_card {
    background-color: #fff7ed;
    border: 1.5px solid #fed7aa;
    border-left: 4px solid #ea580c;
    border-radius: 14px;
}
QFrame#stock_diff_card[direction=&quot;up&quot;] {
    background-color: #f0fdf4;
    border-color: #bbf7d0;
    border-left-color: #16a34a;
}
QFrame#stock_diff_card[direction=&quot;down&quot;] {
    background-color: #fef2f2;
    border-color: #fecaca;
    border-left-color: #dc2626;
}
QFrame#stock_diff_card[direction=&quot;same&quot;] {
    background-color: #f8fafc;
    border-color: #e6ebf2;
    border-left-color: #64748b;
}
QLabel#stock_diff_label {
    color: #9a3412;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    background: transparent;
}
QLabel#stock_diff_value {
    color: #ea580c;
    font-size: 28px;
    font-weight: 800;
    background: transparent;
}
QLabel#stock_diff_value[direction=&quot;up&quot;]   { color: #16a34a; }
QLabel#stock_diff_value[direction=&quot;down&quot;] { color: #dc2626; }
QLabel#stock_diff_value[direction=&quot;same&quot;] { color: #64748b; }

/* Boutons +/- (icône seulement) */
QPushButton#btn_quick_sub {
    background-color: #fee2e2;
    border: 1px solid #fecaca;
    border-radius: 11px;
    min-width: 44px;
    min-height: 44px;
    max-width: 44px;
    max-height: 44px;
    padding: 0;
}
QPushButton#btn_quick_sub:hover { background-color: #fecaca; }
QPushButton#btn_quick_sub:pressed { background-color: #fca5a5; }

QPushButton#btn_quick_add {
    background-color: #dcfce7;
    border: 1px solid #bbf7d0;
    border-radius: 11px;
    min-width: 44px;
    min-height: 44px;
    max-width: 44px;
    max-height: 44px;
    padding: 0;
}
QPushButton#btn_quick_add:hover { background-color: #bbf7d0; }
QPushButton#btn_quick_add:pressed { background-color: #86efac; }

/* Table ajustements */
QTableWidget#table_ajustements {
    background-color: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 12px;
    gridline-color: #f1f5f9;
    outline: none;
}
QTableWidget#table_ajustements::item {
    padding: 8px 6px;
    border-bottom: 1px solid #f1f5f9;
    color: #334155;
    font-size: 12px;
}
QTableWidget#table_ajustements::item:selected {
    background-color: #eff6ff;
    color: #0077B6;
}
QHeaderView::section {
    background-color: #f8fafc;
    color: #94a3b8;
    padding: 10px;
    border: none;
    border-bottom: 1px solid #e6ebf2;
    font-weight: 800;
    font-size: 10px;
    letter-spacing: 1px;
}

/* Erreur */
QLabel#label_error {
    color: #dc2626;
    font-size: 12px;
    font-weight: 600;
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    border-left: 4px solid #dc2626;
    border-radius: 10px;
    padding: 10px 14px;
}

/* Footer */
QFrame#panel_footer {
    background-color: #f8fafc;
    border-top: 1px solid #eef2f7;
    border-bottom-right-radius: 16px;
}

QPushButton#btn_cancel {
    background-color: #ffffff;
    color: #64748b;
    border: 1.5px solid #dbe3ec;
    border-radius: 11px;
    padding: 12px 26px;
    font-size: 13px;
    font-weight: 600;
    min-width: 120px;
    min-height: 44px;
}
QPushButton#btn_cancel:hover {
    background-color: #fef2f2;
    color: #dc2626;
    border-color: #fecaca;
}

QPushButton#btn_save {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0077B6, stop:1 #00B4D8);
    color: #ffffff;
    border: none;
    border-radius: 11px;
    padding: 12px 30px;
    font-size: 13px;
    font-weight: 800;
    min-width: 220px;
    min-height: 44px;
    letter-spacing: 0.3px;
}
QPushButton#btn_save:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #023E8A, stop:1 #0077B6);
}
QPushButton#btn_save:pressed { background: #023E8A; }
QPushButton#btn_save:disabled { background: #cbd5e1; color: #94a3b8; }

/* ScrollArea */
QScrollArea {
    background-color: transparent;
    border: none;
}
QScrollArea &gt; QWidget &gt; QWidget {
    background-color: #ffffff;
}
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 32px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover { background: #94a3b8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px; background: transparent;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}
</string>
