  <property name="styleSheet">
   <string notr="true">/* Global Reset */
QWidget#PharmacieServerWidget {
    background-color: #f8fafc; /* Gris très clair pour le fond */
}

QLabel {
    font-family: &quot;Inter&quot;, &quot;Segoe UI&quot;, sans-serif;
    color: #334155;
}

/* En-tête */
QLabel#titleLabel {
    font-size: 26px;
    font-weight: 800;
    color: #0f172a;
    padding-bottom: 5px;
}

QLabel#serverStatusBadge {
    background-color: #dcfce7;
    color: #15803d;
    padding: 6px 12px;
    border-radius: 15px;
    font-weight: bold;
    border: 1px solid #bbf7d0;
}

/* Sections / Panels */
QFrame.ControlPanel {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}

QLabel.SectionHeader {
    font-size: 12px;
    font-weight: 800;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin-bottom: 5px;
}

/* Boutons */
QPushButton {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
    color: #475569;
}

QPushButton:hover {
    background-color: #f1f5f9;
    border-color: #cbd5e1;
}

QPushButton#btnToggleServer {
    background-color: #2563eb;
    color: white;
    border: none;
    font-size: 13px;
    letter-spacing: 0.5px;
}

QPushButton#btnToggleServer:hover {
    background-color: #1d4ed8;
}

QPushButton#btnKick {
    color: #dc2626;
    border: 1px solid #fecaca;
}

QPushButton#btnKick:hover {
    background-color: #fef2f2;
}

/* Inputs (IP Address) */
QLineEdit {
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 4px;
    background: #ffffff;
    selection-background-color: #93c5fd;
}

QLineEdit:focus {
    border: 2px solid #3b82f6;
}

/* Moniteur de logs */
QTextEdit#logMonitor {
    background-color: #0f172a;
    color: #38bdf8;
    font-family: &quot;Consolas&amp;quot&quot;,&quot;Monaco&amp;quot&quot;,&quot;monospace&quot;;
    border-radius: 8px;
    padding: 10px;
}

/* Listes */
QListWidget#listConnected, QListWidget#listWidget {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background-color: #ffffff;
    outline: none;
    padding: 5px;
}

QListWidget::item {
    padding: 10px;
    border-bottom: 1px solid #f1f5f9;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #eff6ff;
    color: #2563eb;
    font-weight: bold;
}

/* Footer */
QLabel#lblFoot {
    color: #94a3b8;
    font-style: italic;
}</string>
