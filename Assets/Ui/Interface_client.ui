  </property>
  <property name="styleSheet">
   <string notr="true">/* ============================================================
   NOVA PHARMA — PAGE CLIENTS (table performante)
   ============================================================ */

QWidget#PageClients { background-color: transparent; }

/* ══════════════ CARTE PRINCIPALE ══════════════ */
QFrame#card {
    background-color: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 18px;
}

/* ══════════════ HEADER ══════════════ */
QLabel#page_title {
    color: #0f172a;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.3px;
    background: transparent;
}
QLabel#page_subtitle {
    color: #64748b;
    font-size: 12px;
    background: transparent;
}
QLabel#count_badge {
    color: #0077B6;
    font-size: 11px;
    font-weight: 800;
    background-color: #e0f7fa;
    border: 1px solid #bae6fd;
    border-radius: 10px;
    padding: 4px 10px;
}

/* ══════════════ RECHERCHE ══════════════ */
QLineEdit#search_input {
    background-color: #ffffff;
    border: 2px solid #94a3b8;
    border-radius: 11px;
    padding: 10px 14px;
    color: #0f172a;
    font-size: 13px;
    font-weight: 500;
    selection-background-color: #bfdbfe;
}
QLineEdit#search_input:hover {
    border-color: #64748b;
    background-color: #ffffff;
}
QLineEdit#search_input:focus {
    background-color: #ffffff;
    border: 2px solid #0077B6;
    box-shadow: 0 0 0 3px rgba(0, 119, 182, 0.1);
}
QLineEdit#search_input::placeholder {
    color: #94a3b8;
}

/* ══════════════ COMBO FILTRE ══════════════ */
QComboBox#filter_combo {
    background-color: #f8fafc;
    border: 1.5px solid #dbe3ec;
    border-radius: 11px;
    padding: 10px 14px;
    color: #0f172a;
    font-size: 13px;
    font-weight: 600;
    min-width: 160px;
}
QComboBox#filter_combo:hover { border-color: #b9c6d8; }
QComboBox#filter_combo:focus { border-color: #0077B6; }
QComboBox#filter_combo::drop-down { border: none; width: 26px; }
QComboBox#filter_combo::down-arrow {
    image: url(:/Icon/Icons/chevron-down.svg);
    width: 12px; height: 12px;
}
QComboBox#filter_combo QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 10px;
    padding: 6px;
    selection-background-color: #eff6ff;
    selection-color: #0077B6;
}

/* ══════════════ BOUTONS ══════════════ */
QPushButton#btn_new {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0077B6, stop:1 #00B4D8);
    color: #ffffff;
    border: none;
    border-radius: 11px;
    padding: 11px 22px;
    font-size: 13px;
    font-weight: 800;
    min-height: 42px;
    letter-spacing: 0.2px;
}
QPushButton#btn_new:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #023E8A, stop:1 #0077B6);
}
QPushButton#btn_new:pressed { background: #023E8A; }

QPushButton#btn_refresh {
    background-color: #ffffff;
    color: #475569;
    border: 1.5px solid #dbe3ec;
    border-radius: 11px;
    padding: 11px 16px;
    font-size: 13px;
    font-weight: 600;
    min-width: 44px;
    min-height: 42px;
}
QPushButton#btn_refresh:hover {
    background-color: #f8fafc;
    border-color: #c3cedd;
    color: #0f172a;
}

/* Boutons d'action sélection */
QPushButton#btn_view {
    background-color: #eff6ff;
    color: #0077B6;
    border: 1px solid #dbeafe;
    border-radius: 11px;
    padding: 9px 18px;
    font-size: 12px;
    font-weight: 700;
    min-height: 38px;
}
QPushButton#btn_view:hover { background-color: #dbeafe; }
QPushButton#btn_view:disabled {
    background-color: #f8fafc;
    color: #cbd5e1;
    border-color: #e6ebf2;
}

QPushButton#btn_edit {
    background-color: #fef3c7;
    color: #92400e;
    border: 1px solid #fcd34d;
    border-radius: 11px;
    padding: 9px 18px;
    font-size: 12px;
    font-weight: 700;
    min-height: 38px;
}
QPushButton#btn_edit:hover { background-color: #fde68a; }
QPushButton#btn_edit:disabled {
    background-color: #f8fafc;
    color: #cbd5e1;
    border-color: #e6ebf2;
}

QPushButton#btn_delete {
    background-color: #fef2f2;
    color: #dc2626;
    border: 1px solid #fecaca;
    border-radius: 11px;
    padding: 9px 18px;
    font-size: 12px;
    font-weight: 700;
    min-height: 38px;
}
QPushButton#btn_delete:hover { background-color: #fee2e2; }
QPushButton#btn_delete:disabled {
    background-color: #f8fafc;
    color: #cbd5e1;
    border-color: #e6ebf2;
}

/* ══════════════ TABLE ══════════════ */
QTableWidget#clients_table {
    background-color: #ffffff;
    alternate-background-color: #fbfcfe;
    border: none;
    border-top: 1px solid #eef2f7;
    border-bottom: 1px solid #eef2f7;
    gridline-color: transparent;
    outline: none;
    color: #334155;
    font-size: 13px;
}
QTableWidget#clients_table::item {
    padding: 12px 8px;
    border-bottom: 1px solid #f1f5f9;
    color: #334155;
}
QTableWidget#clients_table::item:hover {
    background-color: #f8fafc;
}
QTableWidget#clients_table::item:selected {
    background-color: #eff6ff;
    color: #0077B6;
}

QHeaderView {
    background-color: transparent;
    border: none;
}
QHeaderView::section {
    background-color: #f8fafc;
    color: #94a3b8;
    padding: 14px 10px;
    border: none;
    border-bottom: 2px solid #e6ebf2;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
}
QHeaderView::section:hover {
    background-color: #eff6ff;
    color: #0077B6;
}

QTableCornerButton::section {
    background-color: #f8fafc;
    border: none;
}

/* ══════════════ PAGINATION ══════════════ */
QFrame#pagination_bar {
    background-color: #f8fafc;
    border-top: 1px solid #eef2f7;
    border-bottom: 1px solid #eef2f7;
}
QPushButton#btn_prev, QPushButton#btn_next {
    background-color: #ffffff;
    color: #475569;
    border: 1.5px solid #dbe3ec;
    border-radius: 10px;
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 700;
    min-width: 90px;
    min-height: 36px;
}
QPushButton#btn_prev:hover:enabled, QPushButton#btn_next:hover:enabled {
    background-color: #eff6ff;
    border-color: #93c5fd;
    color: #0077B6;
}
QPushButton#btn_prev:disabled, QPushButton#btn_next:disabled {
    background-color: #f1f5f9;
    color: #cbd5e1;
    border-color: #e6ebf2;
}

QLabel#page_info {
    color: #475569;
    font-size: 12px;
    font-weight: 700;
    background: transparent;
    padding: 0 16px;
}
QLabel#total_info {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}

QFrame#empty_state {
    background-color: #fbfcfe;
    border: 1px dashed #dbe3ec;
    border-radius: 14px;
}
QLabel#empty_text {
    color: #94a3b8;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

/* ══════════════ SCROLLBAR ══════════════ */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #cbd5e1;
    min-height: 32px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover { background: #94a3b8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px; background: transparent;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}
</string>
