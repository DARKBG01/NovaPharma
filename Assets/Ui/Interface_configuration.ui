       <item>
        <layout class="QVBoxLayout" name="logo_layout">
         <property name="spacing">
          <number>10</number>
         </property>
         <item alignment="Qt::AlignmentFlag::AlignHCenter">
          <widget class="QLabel" name="logo_label">
           <property name="minimumSize">
            <size>
             <width>120</width>
             <height>120</height>
