   </size>
  </property>
  <property name="windowTitle">
   <string>Nova Pharma — Inscription</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* ============================================================
   NOVA PHARMA — THÈME WIZARD PREMIUM
   Palette : #023E8A → #0077B6 → #00B4D8 → #90E0EF → #CAF0F8
   Accent Or : #F4A261 | Succès : #16A34A | Erreur : #DC2626
   ============================================================ */

QWizard { background-color: #f0f4f8; }
QWizardPage { background-color: transparent; }

/* ===================== HEADERS GRADIENT ===================== */
#header_welcome, #header_identity, #header_contact,
#header_pharmacy, #header_settings, #header_summary, #header_type, #header_client_config, #header_client_summary {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #023E8A, stop:0.4 #0077B6, stop:1 #00B4D8);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    padding: 0;
}

.header_title {
    color: #ffffff; font-size: 20px; font-weight: 800;
    letter-spacing: 0.5px; background: transparent;
}
.header_subtitle {
    color: #CAF0F8; font-size: 12px; font-weight: 400;
    background: transparent;
}
.header_icon { background: transparent; }

/* ===================== CARDS ===================== */
#card_welcome, #card_identity, #card_contact,
#card_pharmacy, #card_settings, #card_summary {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-top: none;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

/* ===================== SECTION TITLES ===================== */
.section_title {
    color: #023E8A; font-size: 15px; font-weight: 700;
    background: transparent; padding: 0 0 4px 0;
}

/* ===================== LABELS ===================== */
QLabel { color: #334155; font-weight: 500; font-size: 13px; background: transparent; }

/* ===================== INPUTS ===================== */
QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox, QDateEdit {
    background-color: #f8fafc;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    padding: 10px 14px;
    color: #1e293b;
    font-size: 13px;
    selection-background-color: #0077B6;
    selection-color: #ffffff;
}
QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus,
QSpinBox:focus, QDateEdit:focus {
    background-color: #ffffff;
    border: 1.5px solid #00B4D8;
}
QLineEdit:hover, QComboBox:hover, QDoubleSpinBox:hover,
QSpinBox:hover, QDateEdit:hover { border-color: #94A3B8; }
QLineEdit[echoMode=&quot;2&quot;] { font-family: &quot;Segoe UI&quot;, sans-serif; letter-spacing: 2px; }

/* ===================== COMBOBOX ===================== */
QComboBox { padding-right: 30px; }
QComboBox::drop-down {
    subcontrol-origin: padding; subcontrol-position: top right;
    width: 30px; border-left: 1px solid #e2e8f0;
    border-top-right-radius: 10px; border-bottom-right-radius: 10px;
    background: transparent;
}
QComboBox::down-arrow { image: url(:/Icon/Icons/chevron-down.svg); width: 14px; height: 14px; }
QComboBox QAbstractItemView {
    background-color: #ffffff; border: 1px solid #e2e8f0;
    border-radius: 10px;
    selection-background-color: #e0f7fa;
    selection-color: #023E8A;
    outline: none; padding: 4px;
}

/* ===================== SPINBOX ===================== */
QDoubleSpinBox::up-button, QSpinBox::up-button {
    subcontrol-origin: border; subcontrol-position: top right;
    width: 24px; height: 20px; border-top-right-radius: 10px; background: transparent;
}
QDoubleSpinBox::down-button, QSpinBox::down-button {
    subcontrol-origin: border; subcontrol-position: bottom right;
    width: 24px; height: 20px; border-bottom-right-radius: 10px; background: transparent;
}

/* ===================== RADIO / CHECKBOX ===================== */
QRadioButton {
    spacing: 10px; color: #475569; font-size: 13px;
    font-weight: 500; background: transparent; padding: 4px 0;
}
QRadioButton::indicator { width: 20px; height: 20px; }
QRadioButton::indicator:unchecked {
    border: 2px solid #cbd5e1; border-radius: 10px; background-color: #ffffff;
}
QRadioButton::indicator:unchecked:hover { border-color: #00B4D8; }
QRadioButton::indicator:checked {
    border: 2px solid #0077B6; border-radius: 10px; background-color: #0077B6;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iOCIgaGVpZ2h0PSI4IiB2aWV3Qm94PSIwIDAgOCA4IiB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjxjaXJjbGUgY3g9IjQiIGN5PSI0IiByPSIyIiBmaWxsPSJ3aGl0ZSIvPjwvc3ZnPg==);
}
QCheckBox {
    spacing: 10px; color: #475569; font-size: 13px;
    font-weight: 500; background: transparent;
}
QCheckBox::indicator {
    width: 20px; height: 20px; border: 2px solid #cbd5e1;
    border-radius: 5px; background-color: #ffffff;
}
QCheckBox::indicator:hover { border-color: #00B4D8; }
QCheckBox::indicator:checked {
    border: 2px solid #0077B6; background-color: #0077B6;
    image: url(data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMTAiIGhlaWdodD0iOCIgdmlld0JveD0iMCAwIDEwIDgiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PHBhdGggZD0iTTEgNEwzLjUgNi41TDkgMSIgc3Ryb2tlPSJ3aGl0ZSIgc3Ryb2tlLXdpZHRoPSIyIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiLz48L3N2Zz4=);
}

/* ===================== PHOTO UPLOAD ===================== */
#photo_label {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f8fafc, stop:1 #e2e8f0);
    border: 2px dashed #94A3B8; border-radius: 80px;
    color: #64748b; font-size: 12px; font-weight: 500;
    qproperty-alignment: 'AlignCenter';
}
#photo_label:hover {
    border: 2px dashed #00B4D8;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #eff6ff, stop:1 #dbeafe);
}
#btn_upload_photo, #btn_upload_logo {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0077B6, stop:1 #00B4D8);
    color: #ffffff; border: none; border-radius: 10px;
    padding: 10px 24px; font-size: 13px; font-weight: 600;
    letter-spacing: 0.3px;
}
#btn_upload_photo:hover, #btn_upload_logo:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #023E8A, stop:1 #0077B6);
}
#btn_upload_photo:pressed, #btn_upload_logo:pressed { background: #023E8A; }

/* ===================== ROLE CARDS ===================== */
.role_card_selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f0f9ff, stop:1 #e0f7fa);
    border: 2px solid #00B4D8; border-radius: 14px; padding: 20px;
}

/* ===================== FEATURE CARDS ===================== */
.feature_card {
    background-color: #f8fafc; border: 1px solid #e2e8f0;
    border-radius: 12px; padding: 16px;
}
.feature_title { color: #023E8A; font-size: 13px; font-weight: 700; background: transparent; }
.feature_desc  { color: #64748b; font-size: 11px; background: transparent; }

/* ===================== SUMMARY CARDS ===================== */
.summary_card {
    background-color: #f8fafc; border: 1px solid #e2e8f0;
    border-radius: 12px; padding: 16px;
}
.summary_label {
    color: #94A3B8; font-size: 11px; font-weight: 500;
    background: transparent; letter-spacing: 0.5px;
}
.summary_value { color: #1e293b; font-size: 14px; font-weight: 600; background: transparent; }

/* ===================== PASSWORD ERROR ===================== */
#label_pwd_error {
    color: #dc2626; font-size: 12px; font-weight: 600;
    padding: 4px 0 0 4px; background: transparent;
}
#label_pwd_error[valid=&quot;true&quot;] { color: #16a34a; }

/* ===================== INFO BOX ===================== */
#info_box, #info_box_final {
    background-color: #f0f9ff; border: 1px solid #bae6fd;
    border-left: 4px solid #00B4D8; border-radius: 10px; padding: 14px 18px;
}

/* ===================== WIZARD BUTTONS ===================== */
QWizard QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0077B6, stop:1 #00B4D8);
    color: #ffffff; border: none; border-radius: 10px;
    padding: 10px 28px; font-size: 13px; font-weight: 700;
    min-width: 110px; letter-spacing: 0.3px;
}
QWizard QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #023E8A, stop:1 #0077B6);
}
QWizard QPushButton:pressed { background: #023E8A; }
QWizard QPushButton:disabled { background: #e2e8f0; color: #94a3b8; }

QWizard QPushButton[text=&quot;Cancel&quot;],
QWizard QPushButton[text=&quot;Annuler&quot;],
QWizard QPushButton[text=&quot;&amp;Annuler&quot;],
QWizard QPushButton[text=&quot;&lt; &amp;Back&quot;],
QWizard QPushButton[text=&quot;&lt; Back&quot;],
QWizard QPushButton[text=&quot;&amp;Précédent&quot;],
QWizard QPushButton[text=&quot;Précédent&quot;] {
    background: transparent; color: #64748b; border: 1.5px solid #e2e8f0;
}
QWizard QPushButton[text=&quot;Cancel&quot;]:hover,
QWizard QPushButton[text=&quot;Annuler&quot;]:hover,
QWizard QPushButton[text=&quot;&amp;Annuler&quot;]:hover,
QWizard QPushButton[text=&quot;&lt; &amp;Back&quot;]:hover,
QWizard QPushButton[text=&quot;&lt; Back&quot;]:hover,
QWizard QPushButton[text=&quot;&amp;Précédent&quot;]:hover,
QWizard QPushButton[text=&quot;Précédent&quot;]:hover {
    background: #fef2f2; color: #dc2626; border-color: #fecaca;
}
</string>
