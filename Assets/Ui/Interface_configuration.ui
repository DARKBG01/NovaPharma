         <property name="styleSheet">
          <string notr="true">#label_client_test_result {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 12px 16px;
    color: #64748b;
    font-size: 12px;
    font-weight: 600;
}
#label_client_test_result[status=&quot;success&quot;] {
    background-color: #dcfce7;
    border: 1px solid #bbf7d0;
    color: #15803d;
}
#label_client_test_result[status=&quot;error&quot;] {
    background-color: #fee2e2;
    border: 1px solid #fecaca;
    color: #b91c1c;
}
#label_client_test_result[status=&quot;pending&quot;] {
    background-color: #eff6ff;
    border: 1px solid #bfdbfe;
    color: #1e40af;
}</string>
