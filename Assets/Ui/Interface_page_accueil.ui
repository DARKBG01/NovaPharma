<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>PageAccueil</class>
 <widget class="QWidget" name="PageAccueil">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1200</width><height>800</height></rect></property>
  <property name="styleSheet"><string notr="true">
/* ══════════════════════════════════════════════════════════
   PAGE ACCUEIL — Nova Pharma
   ══════════════════════════════════════════════════════════ */
QWidget#PageAccueil { background: #f0f4f8; }
QWidget#PageAccueil QLabel { background: transparent; }

/* ═══════════════ HERO ═══════════════ */
QFrame#header_frame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #023E8A, stop:0.5 #0077B6, stop:1 #00B4D8);
    border-radius: 20px;
    border: none;
}
QFrame#header_frame QLabel { color: #ffffff; }

QLabel#lbl_salutation {
    font-size: 14px; font-weight: 600;
    color: rgba(255,255,255,0.85);
}
QLabel#lbl_date {
    font-size: 11px; font-weight: 600;
    color: rgba(255,255,255,0.65); letter-spacing: 0.5px;
}
QLabel#lbl_ca_title {
    font-size: 10px; font-weight: 800;
    color: rgba(255,255,255,0.75); letter-spacing: 2px;
}
QLabel#lbl_ca_value {
    font-size: 42px; font-weight: 800;
    color: #ffffff; letter-spacing: -1px;
}
QLabel#lbl_ca_trend {
    font-size: 12px; font-weight: 700;
    color: rgba(255,255,255,0.9);
}
QLabel#lbl_periode_title {
    font-size: 10px; font-weight: 800;
    color: rgba(255,255,255,0.75); letter-spacing: 2px;
}

/* ═══════════════ PILLS période ═══════════════ */
QPushButton[pill="true"] {
    background: rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.8);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 17px;
    padding: 0 20px;
    font-size: 11px;
    font-weight: 700;
    min-height: 34px;
    letter-spacing: 0.3px;
}
QPushButton[pill="true"]:hover {
    background: rgba(255,255,255,0.25);
    color: #ffffff;
}
QPushButton[pill="true"]:checked {
    background: #ffffff;
    color: #023E8A;
    border-color: #ffffff;
}

/* ═══════════════ KPI CARDS ═══════════════ */
QFrame#kpi_ventes, QFrame#kpi_panier,
QFrame#kpi_clients, QFrame#kpi_ruptures {
    background: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 14px;
}
QFrame#kpi_ventes:hover    { border-color: #0077B6; }
QFrame#kpi_panier:hover    { border-color: #00B4D8; }
QFrame#kpi_clients:hover   { border-color: #16A34A; }
QFrame#kpi_ruptures:hover  { border-color: #DC2626; }

QLabel#kpi_ventes_icon    { background: #0077B620; border-radius: 10px; }
QLabel#kpi_panier_icon    { background: #00B4D820; border-radius: 10px; }
QLabel#kpi_clients_icon   { background: #16A34A20; border-radius: 10px; }
QLabel#kpi_ruptures_icon  { background: #DC262620; border-radius: 10px; }

QLabel#kpi_ventes_title   { font-size: 10px; font-weight: 800; color: #0077B6; letter-spacing: 1.2px; }
QLabel#kpi_panier_title   { font-size: 10px; font-weight: 800; color: #00B4D8; letter-spacing: 1.2px; }
QLabel#kpi_clients_title  { font-size: 10px; font-weight: 800; color: #16A34A; letter-spacing: 1.2px; }
QLabel#kpi_ruptures_title { font-size: 10px; font-weight: 800; color: #DC2626; letter-spacing: 1.2px; }

QLabel#kpi_ventes_value, QLabel#kpi_panier_value,
QLabel#kpi_clients_value, QLabel#kpi_ruptures_value {
    font-size: 26px; font-weight: 800;
    color: #0f172a; letter-spacing: -0.5px;
}
QLabel#kpi_ventes_trend, QLabel#kpi_panier_trend,
QLabel#kpi_clients_trend, QLabel#kpi_ruptures_trend {
    font-size: 11px; font-weight: 700; color: #16A34A;
}
QLabel#kpi_ventes_sub, QLabel#kpi_panier_sub,
QLabel#kpi_clients_sub, QLabel#kpi_ruptures_sub {
    font-size: 10px; font-weight: 600; color: #94a3b8;
}

/* ═══════════════ CARTES TOP5 / ALERTES ═══════════════ */
QFrame#card_top5, QFrame#card_alertes {
    background: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 14px;
}
QLabel#lbl_top5_title, QLabel#lbl_alertes_title {
    font-size: 14px; font-weight: 800; color: #0f172a;
}
QLabel#lbl_alertes_count {
    background: #fef2f2;
    color: #b91c1c;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 10px; font-weight: 800;
}

/* ═══════════════ BANDEAU SECONDAIRE ═══════════════ */
QFrame#secondary_bar {
    background: #ffffff;
    border: 1px solid #e6ebf2;
    border-radius: 12px;
}
QLabel#blk_stock_title,
QLabel#blk_marge_title,
QLabel#blk_annul_title {
    font-size: 9px; font-weight: 800;
    color: #94a3b8; letter-spacing: 1.2px;
}
QLabel#blk_stock_value,
QLabel#blk_marge_value,
QLabel#blk_annul_value {
    font-size: 16px; font-weight: 800;
    color: #0f172a;
}
</string></property>

